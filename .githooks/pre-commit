#!/usr/bin/env bash
# Pre-commit hook (T11, 2026-10-18): the AGENTS.md budget gate, the JS
# no-undef gate (2026-10-23: the `bin is not defined` class that shipped
# through a shared probe module), the docs-truth gates (corpus counts and
# relative links), the art-dupl zero-group gate (2026-10-25: three red CI
# pushes because the gate only lived in CI), then any flake-installed hook
# (git-hooks.nix's treefmt) so routing commits through .githooks/ never
# silently drops a check the devShell had installed.
# Activate once per clone:  git config core.hooksPath .githooks
# With hooksPath set, EVERY committer in this clone is gated — including
# the auto-commit daemon, which is the point (the daemon was the one
# committer that could push AGENTS.md past 219 lines unnoticed).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

"$root/scripts/check-agents-budget.sh" "$root/AGENTS.md"
"$root/scripts/check-js-lint.sh"
"$root/scripts/check-docs-counts.sh"
"$root/scripts/check-doc-links.sh"
"$root/scripts/check-doc-test-claims.sh"
"$root/scripts/check-dedup-gate.sh"

if [ -x "$root/.git/hooks/pre-commit" ]; then
	exec "$root/.git/hooks/pre-commit" "$@"
fi
