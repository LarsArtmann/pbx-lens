#!/usr/bin/env bash
# Pre-commit hook (T11, 2026-10-18): the AGENTS.md budget gate, then any
# flake-installed hook (git-hooks.nix's treefmt) so routing commits through
# .githooks/ never silently drops a check the devShell had installed.
# Activate once per clone:  git config core.hooksPath .githooks
# With hooksPath set, EVERY committer in this clone is gated — including
# the auto-commit daemon, which is the point (the daemon was the one
# committer that could push AGENTS.md past 219 lines unnoticed).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

"$root/scripts/check-agents-budget.sh" "$root/AGENTS.md"

if [ -x "$root/.git/hooks/pre-commit" ]; then
	exec "$root/.git/hooks/pre-commit" "$@"
fi
