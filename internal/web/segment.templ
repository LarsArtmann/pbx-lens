package web

import (
	"net/url"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
)

// segmentRoute is one number's trend page (/segments/{number}, plan P16):
// the dashboard's own cards — volume, AI share, spend, quality — narrowed
// to every call involving the number on either side. Reusing the dashboard
// components keeps one rendering of each aggregate, so the segment page can
// never drift from the dashboard table that linked here.
templ segmentRoute(nonce string, number string, stats DashboardStats, now time.Time) {
	@shell(nonce, "Segment "+number+" — pbx-lens", "/segments") {
		@display.PageHeader(display.PageHeaderProps{
			Title:    number,
			Subtitle: "Every call involving this number on either side, last 30 days",
		})
		<div class="mb-4">
			@display.Button(display.ButtonProps{
				Text:    "Open the call list",
				Href:    "/?number=" + url.QueryEscape(number),
				Variant: display.ButtonGhost,
				Size:    display.ButtonSizeSM,
			})
		</div>
		if stats.Total == 0 {
			@display.EmptyState(display.EmptyStateProps{
				Title:       "No calls for this number",
				Description: "Nothing in the index involves this number in the window. Numbers appear here once an indexed call carries them on either side.",
				Icon:        icons.Phone,
			})
		} else {
			@statCards(stats, now)
			@volumeCard(stats)
			@qualityCard(stats)
		}
	}
}
