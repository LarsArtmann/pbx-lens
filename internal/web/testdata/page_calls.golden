			(function() {
				var html = document.documentElement;

				function syncToggleAria(btn) {
					if (btn) btn.setAttribute('aria-checked', String(html.classList.contains('dark')));
				}

				// Always sync aria-checked, even after htmx swap re-injects a button
				// with the hardcoded aria-checked="false". This runs on every render;
				// the click listener below is guarded so it only attaches once.
				document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);

				if (!window.tcThemeToggleAttached) {
					window.tcThemeToggleAttached = true;

					document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var isDark = html.classList.contains('dark');
					if (isDark) {
						html.classList.remove('dark');
						try { localStorage.setItem('theme', 'light'); } catch(e) {}
					} else {
						html.classList.add('dark');
						try { localStorage.setItem('theme', 'dark'); } catch(e) {}
					}
					html.style.colorScheme = isDark ? 'light' : 'dark';
					document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);
					});
				}
			})();
		</script></div><div class="flex items-center sm:hidden"><button type="button" class="dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:text-gray-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset hover:bg-gray-100 hover:text-gray-500 inline-flex items-center justify-center motion-reduce:duration-0 motion-reduce:transition-none p-2 rounded-md text-gray-400 transition-colors" aria-controls="tc-mobile-menu-NORMALIZED" aria-expanded="false" data-mobile-menu-toggle="tc-mobile-menu-NORMALIZED"><span class="sr-only">Open main menu</span><svg class="block h-6 tc-menu-open w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path></svg><svg class="h-6 hidden tc-menu-close w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg></button></div></div></div><div class="hidden sm:hidden" id="tc-mobile-menu-NORMALIZED" data-mobile-menu-id="tc-mobile-menu-NORMALIZED"><div class="border-gray-200 border-t dark:border-gray-800 pb-3 pt-2 space-y-1"><a href="/" class="bg-blue-50 block border-blue-500 border-s-4 dark:bg-blue-900/20 dark:text-blue-300 font-medium motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-blue-700 transition-colors" aria-current="page">Calls</a><a href="/search" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:bg-gray-50 hover:border-gray-300 hover:text-gray-700 motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-gray-500 transition-colors">Search</a><a href="/dashboard" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:bg-gray-50 hover:border-gray-300 hover:text-gray-700 motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-gray-500 transition-colors">Dashboard</a></div></div><script>
			if (!window.tcMobileMenuAttached) {
				window.tcMobileMenuAttached = true;
				function tcMobileMenuSet(menu, btn, open) {
					var nav = btn.closest('nav');
					if (!nav) return;
					var openIcon = nav.querySelector('.tc-menu-open');
					var closeIcon = nav.querySelector('.tc-menu-close');
					if (!openIcon || !closeIcon) return;
					if (open) {
						menu.classList.remove('hidden');
						openIcon.classList.add('hidden');
						closeIcon.classList.remove('hidden');
						btn.setAttribute('aria-expanded', 'true');
						var first = menu.querySelector('a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])');
						if (first) first.focus();
					} else {
						menu.classList.add('hidden');
						openIcon.classList.remove('hidden');
						closeIcon.classList.add('hidden');
						btn.setAttribute('aria-expanded', 'false');
						btn.focus();
					}
				}
				document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-mobile-menu-toggle]');
					if (!btn) return;
					var menuId = btn.getAttribute('data-mobile-menu-toggle');
					var nav = btn.closest('nav');
					if (!nav) return;
					var menu = nav.querySelector('[data-mobile-menu-id="' + menuId + '"]');
					if (!menu) return;
					tcMobileMenuSet(menu, btn, menu.classList.contains('hidden'));
				});
				document.addEventListener('keydown', function(e) {
					if (e.key !== 'Escape') return;
					var menu = e.target.closest('[data-mobile-menu-id]');
					if (!menu) return;
					if (menu.classList.contains('hidden')) return;
					var menuId = menu.getAttribute('data-mobile-menu-id');
					var btn = document.querySelector('[data-mobile-menu-toggle="' + menuId + '"]');
					if (!btn) return;
					e.preventDefault();
					tcMobileMenuSet(menu, btn, false);
				});
			}
		</script></nav><div class="flex-1 lg:px-8 max-w-7xl mx-auto px-4 py-8 sm:px-6 w-full"><div hx-get="/frag/staleness" hx-trigger="every 60s" hx-swap="outerHTML" aria-live="polite" class="">STALENESS_REGION</div><div class="mb-6"><div class="flex flex-wrap gap-4 items-center justify-between"><div class="min-w-0"><h1 class="break-after-avoid dark:text-white font-bold text-2xl text-gray-900 tracking-tight">Calls</h1><p class="dark:text-gray-400 mt-1 text-gray-500 text-sm">Every call the PBX ever saw</p></div><div class="flex-shrink-0"><a href="/api/export.csv" class="bg-white cursor-pointer dark:bg-gray-800 dark:hover:bg-gray-700 dark:ring-gray-600 dark:text-white disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 font-semibold hover:bg-gray-50 inline-flex items-center justify-center px-3 py-2 ring-1 ring-gray-300 ring-inset rounded-md text-gray-900 text-sm transition-colors" download title="Streams every matching call. An export that cannot make progress ends with an EXPORT_INCOMPLETE marker row in the file."><svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path></svg>Export CSV</a></div></div></div><form action="/" method="GET" class="flex flex-wrap gap-3 items-end mb-6"><label for="direction" class="block dark:text-white font-medium leading-6 text-gray-900 text-sm">Direction </label><select name="direction" id="direction" class="block border-0 caret-blue-600 dark:bg-gray-800 dark:caret-blue-400 dark:focus:ring-blue-500 dark:placeholder:text-gray-500 dark:ring-gray-700 dark:text-white focus:ring-2 focus:ring-blue-600 focus:ring-inset placeholder:text-gray-400 px-3 py-1.5 ring-1 ring-gray-300 ring-inset rounded-md shadow-xs sm:leading-6 sm:text-sm text-gray-900 transition-