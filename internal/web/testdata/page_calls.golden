if(!window.tcTableRowHrefAttached){window.tcTableRowHrefAttached=true;document.addEventListener('click',function(e){var row=e.target.closest('tr[data-tc-row-href]');if(!row)return;if(e.target.closest('a[href],button:not([disabled]),input,select,textarea,[contenteditable]'))return;window.location.href=row.dataset.tcRowHref;});document.addEventListener('keydown',function(e){var row=e.target.closest('tr[data-tc-row-href]');if(!row)return;if(e.key==='Enter'||e.key===' '){if(e.target.closest('a[href],button:not([disabled]),input,select,textarea,[contenteditable]'))return;e.preventDefault();window.location.href=row.dataset.tcRowHref;}});document.body.addEventListener('htmx:afterSettle',function(){document.querySelectorAll('tr[data-tc-row-href]').forEach(function(r){if(!r.hasAttribute('tabindex'))r.setAttribute('tabindex','0');if(!r.hasAttribute('role'))r.setAttribute('role','link');});});}
</script>
 <div class="border-gray-200 border-t dark:border-gray-700 dark:text-gray-400 mt-4 px-4 py-2.5 text-gray-500 text-xs" role="note">Exports stream every matching call with no row cap. If a single timestamp groups more calls than one page can carry, the file ends with an <code>EXPORT_INCOMPLETE</code> marker (<code>lens.web.export_cursor_stalled</code>) instead of truncating silently — narrow the range with from/to and retry.</div></div><footer class="bg-white border-gray-200 border-t dark:bg-gray-900 dark:border-gray-800" aria-label="Footer"><div class="lg:px-8 max-w-7xl mx-auto px-4 py-6 sm:px-6"><p class="dark:text-gray-400 text-center text-gray-500 text-sm">&copy; 2026 pbx-lens. All rights reserved.</p><div class="dark:text-gray-400 mt-4 text-center text-gray-500 text-xs"><div class="dark:text-gray-400 flex flex-wrap gap-2 items-center justify-between text-gray-500 text-xs"><span>Read-only index — every source stays authoritative; this DB is disposable.</span> </div></div></div></footer><div id="tc-error-announcer" aria-live="polite" class="sr-only"></div><script>
		(function() {
			'use strict';

			var MAX_ERROR_HISTORY = 10;
			var MAX_RETRIES = 2;
			var RETRY_DELAY_MS = 1000;

			const errorHistory = [];

			// Family-aware toast type mapping
			var tcFamilyToastMap = {
				'rejection': 'warning',
				'conflict': 'warning',
				'transient': 'info',
				'corruption': 'error',
				'infrastructure': 'error',
				'orchestration': 'error'
			};

			function tcParseErrorBody(xhr) {
				if (!xhr || !xhr.responseText) return null;
				try {
					var body = JSON.parse(xhr.responseText);
					if (body && (body.family || body.code || body.message)) return body;
				} catch (e) {}
				return null;
			}

			function tcHandleHTMXError(event, type) {
				var xhr = event.detail.xhr;

				console.error('HTMX Error:', {
					type: type,
					status: xhr ? xhr.status : 0,
					statusText: xhr ? xhr.statusText : '',
					url: xhr ? xhr.responseURL : 'unknown',
					timestamp: new Date().toISOString()
				});

				errorHistory.unshift({
					type: type,
					status: xhr ? xhr.status : 0,
					url: xhr ? xhr.responseURL : '',
					timestamp: Date.now()
				});
				if (errorHistory.length > MAX_ERROR_HISTORY) {
					errorHistory.length = MAX_ERROR_HISTORY;
				}

				if (typeof tcShowToast === 'function') {
					var message, toastType, title;
					var structured = tcParseErrorBody(xhr);

					if (type === 'network' || !xhr || xhr.status === 0) {
						message = 'Network error. Check your connection.';
						toastType = 'error';
						title = 'Connection Lost';
					} else if (structured && structured.family) {
						message = structured.message || 'An error occurred.';
						toastType = tcFamilyToastMap[structured.family] || 'error';
						title = structured.title || (structured.code || 'Error');
						if (structured.fix) message += ' ' + structured.fix;
					} else if (xhr.status >= 500) {
						message = 'Server error. Please try again.';
						toastType = 'error';
						title = 'Server Error';
					} else if (xhr.status === 404) {
						message = 'Requested resource not found.';
						toastType = 'warning';
						title = 'Not Found';
					} else if (xhr.status === 403) {
						message = 'You do not have permission to perform this action.';
						toastType = 'warning';
						title = 'Access Denied';
					} else if (xhr.status === 401) {
						message = 'Your session has expired. Please refresh the page.';
						toastType = 'error';
						title = 'Authentication Required';
						setTimeout(function() { window.location.reload(); }, 3000);
					} else if (xhr.status >= 400) {
						message = 'Request failed. Please try again.';
						if (structured && structured.message) message = structured.message;
						toastType = 'error';
						title = structured && structured.code ? structured.code : 'Request Failed';
					} else {
						message = 'An unexpected error occurred.';
						toastType = 'error';
						title = 'Error';
					}
					tcShowToast(message, toastType, title, 5000);
				}
				var announcer = document.getElementById('tc-error-announcer');
				if (announcer) announcer.textContent = message || 'An error occurred.';
			}

			document.addEventListener('htmx:sendError', function(event) {
				tcHandleHTMXError(event, 'network');
			});

			document.addEventListener('htmx:responseError', function(event) {
				var xhr = event.detail.xhr;
				var elt = event.detail.elt;
				if (xhr && (xhr.status >= 500 || xhr.status === 0) && elt) {
					var retries = parseInt(elt.getAttribute('data-tc-retry') || '0');
					if (retries < MAX_RETRIES) {
						elt.setAttribute('data-tc-retry', String(retries + 1));
						setTimeout(function() {
							var triggerSpec = elt.getAttribute('hx-trigger');
							var eventName = triggerSpec ? triggerSpec.split(' ')[0].trim() : 'click';
							htmx.trigger(elt, eventName);
						}, RETRY_DELAY_MS * (retries + 1));
						return;
					}
					elt.removeAttribute('data-tc-retry');
				}
				tcHandleHTMXError(event, 'response');
			});

			document.addEventListener('htmx:afterRequest', function(event) {
				var xhr = event.detail.xhr;
				if (xhr && xhr.status >= 200 && xhr.status < 300) {
					var elt = event.detail.elt;
					if (elt) elt.removeAttribute('data-tc-retry');
				}
			});

			window.htmxErrorHistory = function() { return errorHistory; };
		})();
	</script></main></body></html>