		</script><link rel="stylesheet" href="/app.css"> <script src="/static/htmx.min.js"></script> </head><body class="antialiased bg-white dark:bg-gray-950 dark:selection:bg-blue-900 dark:selection:text-blue-100 dark:text-gray-100 flex flex-col min-h-dvh motion-reduce:scroll-auto scroll-smooth selection:bg-blue-100 selection:text-blue-900 text-gray-900"><a href="#main-content" class="dark:focus:bg-blue-500 dark:focus:ring-blue-400 dark:focus:ring-offset-gray-900 focus:absolute focus:bg-blue-600 focus:not-sr-only focus:outline-hidden focus:px-4 focus:py-2 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:rounded-md focus:shadow-lg focus:start-2 focus:text-white focus:top-2 focus:z-50 sr-only">Skip to main content</a> <main id="main-content" tabindex="-1" class="flex-1"><div id="tc-toast-container" class="bottom-4 fixed flex flex-col gap-2 inset-e-4 pointer-events-none z-50" aria-live="polite" aria-atomic="true"><!-- Toasts are injected here --></div><script>var tcToastColors = {'success': {border:'border-green-200 dark:border-green-800',bg:'bg-green-50 dark:bg-green-900/20',text:'text-green-800 dark:text-green-200',icon:'text-green-600 dark:text-green-400'},'error': {border:'border-red-200 dark:border-red-800',bg:'bg-red-50 dark:bg-red-900/20',text:'text-red-800 dark:text-red-200',icon:'text-red-600 dark:text-red-400'},'warning': {border:'border-yellow-200 dark:border-yellow-800',bg:'bg-yellow-50 dark:bg-yellow-900/20',text:'text-yellow-800 dark:text-yellow-200',icon:'text-yellow-600 dark:text-yellow-400'},'info': {border:'border-blue-200 dark:border-blue-800',bg:'bg-blue-50 dark:bg-blue-900/20',text:'text-blue-800 dark:text-blue-200',icon:'text-blue-600 dark:text-blue-400'},};
