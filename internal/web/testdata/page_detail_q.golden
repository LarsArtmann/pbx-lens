			if (!window.tcMobileMenuAttached) {
				window.tcMobileMenuAttached = true;
				function tcMobileMenuSet(menu, btn, open) {
					var nav = btn.closest('nav');
					if (!nav) return;
					var openIcon = nav.querySelector('.tc-menu-open');
					var closeIcon = nav.querySelector('.tc-menu-close');
					if (!openIcon || !closeIcon) return;
					if (open) {
						menu.classList.remove('hidden');
						openIcon.classList.add('hidden');
						closeIcon.classList.remove('hidden');
						btn.setAttribute('aria-expanded', 'true');
						var first = menu.querySelector('a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])');
						if (first) first.focus();
					} else {
						menu.classList.add('hidden');
						openIcon.classList.remove('hidden');
						closeIcon.classList.add('hidden');
						btn.setAttribute('aria-expanded', 'false');
						btn.focus();
					}
				}
				document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-mobile-menu-toggle]');
					if (!btn) return;
					var menuId = btn.getAttribute('data-mobile-menu-toggle');
					var nav = btn.closest('nav');
					if (!nav) return;
					var menu = nav.querySelector('[data-mobile-menu-id="' + menuId + '"]');
					if (!menu) return;
					tcMobileMenuSet(menu, btn, menu.classList.contains('hidden'));
				});
				document.addEventListener('keydown', function(e) {
					if (e.key !== 'Escape') return;
					var menu = e.target.closest('[data-mobile-menu-id]');
					if (!menu) return;
					if (menu.classList.contains('hidden')) return;
					var menuId = menu.getAttribute('data-mobile-menu-id');
					var btn = document.querySelector('[data-mobile-menu-toggle="' + menuId + '"]');
					if (!btn) return;
					e.preventDefault();
					tcMobileMenuSet(menu, btn, false);
				});
			}
		</script></nav><div class="flex-1 lg:px-8 max-w-7xl mx-auto px-4 py-8 sm:px-6 w-full"><div class="mb-6"><div class="mb-3"><nav class="flex" aria-label="Breadcrumb"><ol class="inline-flex items-center md:space-x-3 space-x-1"><li class="inline-flex items-center"><a href="/" class="dark:hover:text-white dark:text-gray-400 font-medium hover:text-blue-600 text-gray-700 text-sm">Calls</a></li><li class="inline-flex items-center"><svg class="dark:text-gray-500 h-4 text-gray-400 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-tc-dir-icon><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg><span aria-current="page" class="dark:text-gray-400 font-medium text-gray-500 text-sm">telnyx-conversation</span></li><li class="inline-flex items-center"><svg class="dark:text-gray-500 h-4 text-gray-400 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-tc-dir-icon><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg><span aria-current="page" class="dark:text-gray-400 font-medium text-gray-500 text-sm">Call conv-in</span></li></ol></nav></div><div class="flex flex-wrap gap-4 items-center justify-between"><div class="min-w-0"><h1 class="break-after-avoid dark:text-white font-bold text-2xl text-gray-900 tracking-tight">Call conv-in</h1><p class="dark:text-gray-400 mt-1 text-gray-500 text-sm"><span class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium inline-flex items-center px-2.5 py-0.5 rounded-full text-gray-800 text-xs">telnyx-conversation</span></p></div><div class="flex-shrink-0"><button type="button" data-tc-copy="conv-in" data-tc-copy-label="Copied!" class="bg-gray-50 cursor-pointer dark:bg-gray-700 dark:focus-visible:ring-blue-400 dark:hover:bg-gray-600 dark:ring-gray-600 dark:text-gray-200 focus-visible:ring-2 focus-visible:ring-blue-500 focus:outline-none font-medium gap-1.5 h