function tcShowToast(message, type, title, duration) {
var container = document.getElementById('tc-toast-container');
if (!container) return;
var toast = document.createElement('div');
var typeKey = type || 'info';
var style = tcToastColors[typeKey] || tcToastColors.info;
toast.className = 'pointer-events-auto max-w-sm w-full rounded-lg border shadow-lg dark:shadow-black/20 px-4 py-3 transform transition-all duration-300 motion-reduce:transition-none motion-reduce:duration-0 translate-x-full ' + style.border + ' ' + style.bg + ' ' + style.text;
var inner = document.createElement('div');
inner.className = 'flex items-start gap-3';
var svgEl = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
svgEl.setAttribute('class', 'h-5 w-5 flex-shrink-0 mt-0.5 ' + style.icon);
svgEl.setAttribute('fill', 'none');
svgEl.setAttribute('viewBox', '0 0 24 24');
svgEl.setAttribute('stroke', 'currentColor');
svgEl.innerHTML = (tcToastIcons[typeKey] || tcToastIcons.info);
inner.appendChild(svgEl);
var content = document.createElement('div');
content.className = 'flex-1 min-w-0';
if (title) {
var titleEl = document.createElement('div');
titleEl.className = 'text-sm font-semibold';
titleEl.textContent = title;
content.appendChild(titleEl);
}
var msgEl = document.createElement('div');
msgEl.className = 'text-sm';
msgEl.textContent = message;
content.appendChild(msgEl);
inner.appendChild(content);
var btn = document.createElement('button');
btn.className = 'flex-shrink-0 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-200 transition-colors motion-reduce:transition-none motion-reduce:duration-0';
btn.setAttribute('aria-label', 'Dismiss');
btn.addEventListener('click', function() { this.closest('.pointer-events-auto').remove(); });
btn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">' + (tcToastIcons.dismiss || '') + '</svg>';
inner.appendChild(btn);
toast.appendChild(inner);
container.appendChild(toast);
requestAnimationFrame(function() { toast.classList.remove('translate-x-full'); });
if (duration && duration > 0) {
setTimeout(function() {
toast.classList.add('translate-x-full');
setTimeout(function() { toast.remove(); }, 300);
}, duration);
}
}</script><nav id="pbx-lens-nav" aria-label="Main navigation" class="bg-white border-b border-gray-200 dark:bg-gray-900 dark:border-gray-800 z-40"><div class="lg:px-8 max-w-7xl mx-auto px-4 sm:px-6"><div class="flex items-center justify-between min-h-16"><div class="flex"><div class="flex flex-shrink-0 items-center"><a href="" class="dark:text-blue-400 font-bold text-blue-600 text-xl">pbx-lens</a></div><div class="hidden sm:flex sm:flex-wrap sm:gap-x-8 sm:gap-y-2 sm:ms-6"><a href="/" class="border-b-2 border-blue-500 dark:text-white font-medium inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-900 text-sm transition-colors" aria-current="page">Calls</a><a href="/search" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-500 text-sm transition-colors">Search</a><a href="/dashboard" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-500 text-sm transition-colors">Dashboard</a><a href="/ops" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-500 text-sm transition-colors">Ops</a></div></div><div class="flex gap-2 items-center"><button type="button" class="dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:text-gray-500 hover:bg-gray-100 hover:text-gray-500 motion-reduce:duration-0 motion-reduce:transition-none p-2 rounded-md text-gray-400 transition-colors" data-theme-toggle role="switch" aria-checked="false" aria-label="Toggle theme"><svg class="dark:hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg><svg class="dark:block h-5 hidden w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg></button> <script>
			(function() {
				var html = document.documentElement;

				function syncToggleAria(btn) {
					if (btn) btn.setAttribute('aria-checked', String(html.classList.contains('dark')));
				}

				// Always sync aria-checked, even after htmx swap re-injects a button
				// with the hardcoded aria-checked="false". This runs on every render;
				// the click listener below is guarded so it only attaches once.
				document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);

				if (!window.tcThemeToggleAttached) {
					window.tcThemeToggleAttached = true;

					document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var isDark = html.classList.contains('dark');
					if (isDark) {
						html.classList.remove('dark');
						try { localStorage.setItem('theme', 'light'); } catch(e) {}
					} else {
						html.classList.add('dark');
						try { localStorage.setItem('theme', 'dark'); } catch(e) {}
					}
					html.style.colorScheme = isDark ? 'light' : 'dark';
					document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);
					});
				}
			})();
		</script></div><div class="flex items-center sm:hidden"><button type="button" class="dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:text-gray-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset hover:bg-gray-100 hover:text-gray-500 inline-flex items-center justify-center motion-reduce:duration-0 motion-reduce:transition-none p-2 rounded-md text-gray-400 transition-colors" aria-controls="pbx-lens-nav" aria-expanded="false" data-mobile-menu-toggle="pbx-lens-nav"><span class="sr-only">Open main menu</span><svg class="block h-6 tc-menu-open w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path></svg><svg class="h-6 hidden tc-menu-close w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg></button></div></div></div><div class="hidden sm:hidden" id="pbx-lens-nav" data-mobile-menu-id="pbx-lens-nav"><div class="border-gray-200 border-t dark:border-gray-800 pb-3 pt-2 space-y-1"><a href="/" class="bg-blue-50 block border-blue-500 border-s-4 dark:bg-blue-900/20 dark:text-blue-300 font-medium motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-blue-700 transition-colors" aria-current="page">Calls</a><a href="/search" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:bg-gray-50 hover:border-gray-300 hover:text-gray-700 motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-gray-500 transition-colors">Search</a><a href="/dashboard" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium 