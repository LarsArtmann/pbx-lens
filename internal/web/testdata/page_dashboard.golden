g-transparent print:border-0 print:shadow-none shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h2 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">AI vs human</h2></div></div><div class="px-4 py-5 sm:p-6"><svg viewBox="0 0 400 300" class="h-auto w-full" role="img" aria-hidden="true"><g class="dark:text-gray-500 text-gray-400"><path d="M 200 27 A 123 123 0 1 1 200 273 A 123 123 0 1 1 200 27 Z" fill="currentColor" stroke="white" stroke-width="2" class="dark:stroke-gray-800"></path></g>  <text x="200" y="150" text-anchor="middle" dominant-baseline="middle" class="dark:fill-gray-200 fill-gray-700 font-semibold" font-size="18">0.0%</text> <g transform="translate(20,264)"><rect width="12" height="12" rx="2" class="dark:text-gray-500 text-gray-400" fill="currentColor"></rect> <text x="20" y="11" class="dark:fill-gray-300 fill-gray-600" font-size="11">Human · 2</text></g></svg></div></div><div class="bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 overflow-hidden print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h2 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">Spend</h2></div></div><div class="px-4 py-5 sm:p-6"><div class="py-8 text-center"><p class="dark:text-gray-400 text-gray-500 text-sm">No cost data yet — prices arrive with the Telnyx Detail Records.</p></div></div></div><div class="bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 overflow-hidden print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h2 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">30-day trend</h2></div></div><div class="px-4 py-5 sm:p-6"><svg width="260" height="60" class="overflow-visible" aria-label="Calls per day over the last 30 days"><path d="M 0 60 L 9 60 L 18 60 L 27 60 L 36 60 L 45 60 L 54 60 L 63 60 L 72 60 L 81 60 L 90 60 L 99 60 L 108 60 L 117 60 L 126 60 L 135 60 L 144 60 L 153 60 L 162 60 L 171 60 L 180 60 L 189 60 L 198 60 L 207 60 L 216 60 L 225 60 L 234 60 L 243 60 L 252 0 L 261 60 L 260 60 L 0 60 Z" fill="currentColor" fill-opacity="0.15" class="opacity-50"></path> <polyline points="0,60 9,60 18,60 27,60 36,60 45,60 54,60 63,60 72,60 81,60 90,60 99,60 108,60 117,60 126,60 135,60 144,60 153,60 162,60 171,60 180,60 189,60 198,60 207,60 216,60 225,60 234,60 243,60 252,0 261,60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg></div></div><div class="bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 overflow-hidden print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h2 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">Call quality (MOS)</h2></div></div><div class="px-4 py-5 sm:p-6"><div class="bg-blue-50 border border-blue-200 dark:bg-blue-900/20 dark:border-blue-800 p-4 rounded-md" role="status"><div class="flex"><div class="flex-shrink-0"><svg class="dark:text-blue-400 h-5 text-blue-600 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path></svg></div><div class="flex-1 ms-3"><h3 class="dark:text-blue-200 font-medium text-blue-800 text-sm">Not available yet</h3><div class="dark:text-blue-200 text-blue-800 text-sm"><p>No indexed call has reported a quality score yet. Once calls carry MOS data, this card shows the mean score and its trend.</p></div></div></div></div></div></div></div></div></div><div class="flex justify-end mt-3"><time class="dark:text-gray-500 tabular-nums text-gray-400 text-xs" datetime="SCRUBBED">Updated HH:MM:SS</time></div></div></div><footer class="bg-white border-gray-200 border-t dark:bg-gray-900 dark:border-gray-800" aria-label="Footer"><div class="lg:px-8 max-w-7xl mx-auto px-4 py-6 sm:px-6"><p class="dark:text-gray-400 text-center text-gray-500 text-sm">&copy; 2026 pbx-lens. All rights reserved.</p><div class="dark:text-gray-400 mt-4 text-center text-gray-500 text-xs"><div class="dark:text-gray-400 flex flex-wrap gap-2 items-center justify-between text-gray-500 text-xs"><span>Read-only index — every source stays authoritative; this DB is disposable.</span> </div></div></div></footer><div id="tc-error-announcer" aria-live="polite" class="sr-only"></div><script>
		(function() {
			'use strict';

			var MAX_ERROR_HISTORY = 10;
			var MAX_RETRIES = 2;
			var RETRY_DELAY_MS = 1000;

			const errorHistory = [];

			// Family-aware toast type mapping
			var tcFamilyToastMap = {
				'rejection': 'warning',
				'conflict': 'warning',
				'transient': 'info',
				'corruption': 'error',
				'infrastructure': 'error',
				'orchestration': 'error'
			};

			function tcParseErrorBody(xhr) {
				if (!xhr || !xhr.responseText) return null;
				try {
					var body = JSON.parse(xhr.responseText);
					if (body && (body.family || body.code || body.message)) return body;
				} catch (e) {}
				return null;
			}

			function tcHandleHTMXError(event, type) {
				var xhr = event.detail.xhr;

				console.error('HTMX Error:', {
					type: type,
					status: xhr ? xhr.status : 0,
					statusText: xhr ? xhr.statusText : '',
					url: xhr ? xhr.responseURL : 'unknown',
					timestamp: new Date().toISOString()
				});

				errorHistory.unshift({
					type: type,
					status: xhr ? xhr.status : 0,
					url: xhr ? xhr.responseURL : '',
					timestamp: Date.now()
				});
				if (errorHistory.length > MAX_ERROR_HISTORY) {
					errorHistory.length = MAX_ERROR_HISTORY;
				}

				if (typeof tcShowToast === 'function') {
					var message, toastType, title;
					var structured = tcParseErrorBody(xhr);

					if (type === 'network' || !xhr || xhr.status === 0) {
						message = 'Network error. Check your connection.';
						toastType = 'error';
						title = 'Connection Lost';
					} else if (structured && structured.family) {
						message = structured.message || 'An error occurred.';
						toastType = tcFamilyToastMap[structured.family] || 'error';
						title = structured.title || (structured.code || 'Error');
						if (structured.fix) message += ' ' + structured.fix;
					} else if (xhr.status >= 500) {
						message = 'Server error. Please try again.';
						toastType = 'error';
						title = 'Server Error';
					} else if (xhr.status === 404) {
						message = 'Requested resource not found.';
						toastType = 'warning';
						title = 'Not Found';
					} else if (xhr.status === 403) {
						message = 'You do not have permission to perform this action.';
						toastType = 'warning';
						title = 'Access Denied';
					} else if (xhr.status === 401) {
						message = 'Your session has expired. Please refresh the page.';
						toastType = 'error';
						title = 'Authentication Required';
						setTimeout(function() { window.location.reload(); }, 3000);
					} else if (xhr.status >= 400) {
						message = 'Request failed. Please try again.';
						if (structured && structured.message) message = structured.message;
						toastType = 'error';
						title = structured && structured.code ? structured.code : 'Request Failed';
					} else {
						message = 'An unexpected error occurred.';
						toastType = 'error';
						title = 'Error';
					}
					tcShowToast(message, toastType, title, 5000);
				}
				var announcer = document.getElementById('tc-error-announcer');
				if (announcer) announcer.textContent = message || 'An error occurred.';
			}

			document.addEventListener('htmx:sendError', function(event) {
				tcHandleHTMXError(event, 'network');
			});

			document.addEventListener('htmx:responseError', function(event) {
				var xhr = event.detail.xhr;
				var elt = event.detail.elt;
				if (xhr && (xhr.status >= 500 || xhr.status === 0) && elt) {
					var retries = parseInt(elt.getAttribute('data-tc-retry') || '0');
					if (retries < MAX_RETRIES) {
						elt.setAttribute('data-tc-retry', String(retries + 1));
						setTimeout(function() {
							var triggerSpec = elt.getAttribute('hx-trigger');
							var eventName = triggerSpec ? triggerSpec.split(' ')[0].trim() : 'click';
							htmx.trigger(elt, eventName);
						}, RETRY_DELAY_MS * (retries + 1));
						return;
					}
					elt.removeAttribute('data-tc-retry');
				}
				tcHandleHTMXError(event, 'response');
			});

			document.addEventListener('htmx:afterRequest', function(event) {
				var xhr = event.detail.xhr;
				if (xhr && xhr.status >= 200 && xhr.status < 300) {
					var elt = event.detail.elt;
					if (elt) elt.removeAttribute('data-tc-retry');
				}
			});

			window.htmxErrorHistory = function() { return errorHistory; };
		})();
	</script></main></body></html>