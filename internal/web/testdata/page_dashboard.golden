<!doctype html><html lang="en" class="h-full"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="color-scheme" content="light dark"><title>Dashboard — pbx-lens</title><meta name="robots" content="noindex"><link rel="icon" href="/favicon.svg"><meta name="theme-color" content="#0f766e" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)"><meta property="og:title" content="Dashboard — pbx-lens"><meta property="og:type" content="website"><meta property="og:locale" content="en"><meta name="twitter:card" content="summary"><meta name="twitter:title" content="Dashboard — pbx-lens"><script>
			(function() {
				var theme;
				try { theme = localStorage.getItem('theme'); } catch(e) {}
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = theme === 'dark' || (!theme && prefersDark);
				if (isDark) {
					document.documentElement.classList.add('dark');
				}
				document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
			})();
		</script><link rel="stylesheet" href="/app.css"> <script src="/static/htmx.min.js"></script> </head><body class="antialiased bg-white dark:bg-gray-950 dark:selection:bg-blue-900 dark:selection:text-blue-100 dark:text-gray-100 flex flex-col min-h-dvh motion-reduce:scroll-auto scroll-smooth selection:bg-blue-100 selection:text-blue-900 text-gray-900"><a href="#main-content" class="dark:focus:bg-blue-500 dark:focus:ring-blue-400 dark:focus:ring-offset-gray-900 focus:absolute focus:bg-blue-600 focus:not-sr-only focus:outline-hidden focus:px-4 focus:py-2 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:rounded-md focus:shadow-lg focus:start-2 focus:text-white focus:top-2 focus:z-50 sr-only">Skip to main content</a> <main id="main-content" tabindex="-1" class="flex-1"><div id="tc-toast-container" class="bottom-4 fixed flex flex-col gap-2 inset-e-4 pointer-events-none z-50" aria-live="polite" aria-atomic="true"><!-- Toasts are injected here --></div><script>var tcToastColors = {'success': {border:'border-green-200 dark:border-green-800',bg:'bg-green-50 dark:bg-green-900/20',text:'text-green-800 dark:text-green-200',icon:'text-green-600 dark:text-green-400'},'error': {border:'border-red-200 dark:border-red-800',bg:'bg-red-50 dark:bg-red-900/20',text:'text-red-800 dark:text-red-200',icon:'text-red-600 dark:text-red-400'},'warning': {border:'border-yellow-200 dark:border-yellow-800',bg:'bg-yellow-50 dark:bg-yellow-900/20',text:'text-yellow-800 dark:text-yellow-200',icon:'text-yellow-600 dark:text-yellow-400'},'info': {border:'border-blue-200 dark:border-blue-800',bg:'bg-blue-50 dark:bg-blue-900/20',text:'text-blue-800 dark:text-blue-200',icon:'text-blue-600 dark:text-blue-400'},};
var tcToastIcons = {'success':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>','error':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>','warning':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.664-.833-2.464 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"/>','info':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>',dismiss:'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>'};
function tcShowToast(message, type, title, duration) {
var container = document.getElementById('tc-toast-container');
if (!container) return;
var toast = document.createElement('div');
var typeKey = type || 'info';
var style = tcToastColors[typeKey] || tcToastColors.info;
toast.className = 'pointer-events-auto max-w-sm w-full rounded-lg border shadow-lg dark:shadow-black/20 px-4 py-3 transform transition-all duration-300 motion-reduce:transition-none motion-reduce:duration-0 translate-x-full ' + style.border + ' ' + style.bg + ' ' + style.text;
var inner = document.createElement('div');
inner.className = 'flex items-start gap-3';
var svgEl = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
svgEl.setAttribute('class', 'h-5 w-5 flex-shrink-0 mt-0.5 ' + style.icon);
svgEl.setAttribute('fill', 'none');
svgEl.setAttribute('viewBox', '0 0 24 24');
svgEl.setAttribute('stroke', 'currentColor');
svgEl.innerHTML = (tcToastIcons[typeKey] || tcToastIcons.info);
inner.appendChild(svgEl);
var content = document.createElement('div');
content.className = 'flex-1 min-w-0';
if (title) {
var titleEl = document.createElement('div');
titleEl.className = 'text-sm font-semibold';
titleEl.textContent = title;
content.appendChild(titleEl);
}
var msgEl = document.createElement('div');
msgEl.className = 'text-sm';
msgEl.textContent = message;
content.appendChild(msgEl);
inner.appendChild(content);
var btn = document.createElement('button');
btn.className = 'flex-shrink-0 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-200 transition-colors motion-reduce:transition-none motion-reduce:duration-0';
btn.setAttribute('aria-label', 'Dismiss');
btn.addEventListener('click', function() { this.closest('.pointer-events-auto').remove(); });
btn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">' + (tcToastIcons.dismiss || '') + '</svg>';
inner.appendChild(btn);
toast.appendChild(inner);
container.appendChild(toast);
requestAnimationFrame(function() { toast.classList.remove('translate-x-full'); });
if (duration && duration > 0) {
setTimeout(function() {
toast.classList.add('translate-x-full');
setTimeout(function() { toast.remove(); }, 300);
}, duration);
}
}</script><nav id="pbx-lens-nav" aria-label="Main navigation" class="bg-white border-b border-gray-200 dark:bg-gray-900 dark:border-gray-800 z-40"><div class="lg:px-8 max-w-7xl mx-auto px-4 sm:px-6"><div class="flex items-center justify-between min-h-16"><div class="flex"><div class="flex flex-shrink-0 items-center"><a href="" class="dark:text-blue-400 font-bold text-blue-600 text-xl">pbx-lens</a></div><div class="hidden sm:flex sm:flex-wrap sm:gap-x-8 sm:gap-y-2 sm:ms-6"><a href="/" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-500 text-sm transition-colors">Calls</a><a href="/search" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-500 text-sm transition-colors">Search</a><a href="/dashboard" class="border-b-2 border-blue-500 dark:text-white font-medium inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-900 text-sm transition-colors" aria-current="page">Dashboard</a><a href="/ops" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2 py-1.5 text-gray-500 text-sm transition-colors">Ops</a></div></div><div class="flex gap-2 items-center"><button type="button" class="dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:text-gray-500 hover:bg-gray-100 hover:text-gray-500 motion-reduce:duration-0 motion-reduce:transition-none p-2 rounded-md text-gray-400 transition-colors" data-theme-toggle role="switch" aria-checked="false" aria-label="Toggle theme"><svg class="dark:hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg><svg class="dark:block h-5 hidden w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg></button> <script>
			(function() {
				var html = document.documentElement;

				function syncToggleAria(btn) {
					if (btn) btn.setAttribute('aria-checked', String(html.classList.contains('dark')));
				}

				// Always sync aria-checked, even after htmx swap re-injects a button
				// with the hardcoded aria-checked="false". This runs on every render;
				// the click listener below is guarded so it only attaches once.
				document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);

				if (!window.tcThemeToggleAttached) {
					window.tcThemeToggleAttached = true;

					document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var isDark = html.classList.contains('dark');
					if (isDark) {
						html.classList.remove('dark');
						try { localStorage.setItem('theme', 'light'); } catch(e) {}
					} else {
						html.classList.add('dark');
						try { localStorage.setItem('theme', 'dark'); } catch(e) {}
					}
					html.style.colorScheme = isDark ? 'light' : 'dark';
					document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);
					});
				}
			})();
		</script></div><div class="flex items-center sm:hidden"><button type="button" class="dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:text-gray-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset hover:bg-gray-100 hover:text-gray-500 inline-flex items-center justify-center motion-reduce:duration-0 motion-reduce:transition-none p-2 rounded-md text-gray-400 transition-colors" aria-controls="pbx-lens-nav" aria-expanded="false" data-mobile-menu-toggle="pbx-lens-nav"><span class="sr-only">Open main menu</span><svg class="block h-6 tc-menu-open w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path></svg><svg class="h-6 hidden tc-menu-close w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg></button></div></div></div><div class="hidden sm:hidden" id="pbx-lens-nav" data-mobile-menu-id="pbx-lens-nav"><div class="border-gray-200 border-t dark:border-gray-800 pb-3 pt-2 space-y-1"><a href="/" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:bg-gray-50 hover:border-gray-300 hover:text-gray-700 motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-gray-500 transition-colors">Calls</a><a href="/search" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:bg-gray-50 hover:border-gray-300 hover:text-gray-700 motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-gray-500 transition-colors">Search</a><a href="/dashboard" class="bg-blue-50 block border-blue-500 border-s-4 dark:bg-blue-900/20 dark:text-blue-300 font-medium motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-blue-700 transition-colors" aria-current="page">Dashboard</a><a href="/ops" class="block border-s-4 border-transparent dark:hover:bg-gray-800 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:bg-gray-50 hover:border-gray-300 hover:text-gray-700 motion-reduce:duration-0 motion-reduce:transition-none pe-4 ps-3 py-2 text-base text-gray-500 transition-colors">Ops</a></div></div><script>
			if (!window.tcMobileMenuAttached) {
				window.tcMobileMenuAttached = true;
				function tcMobileMenuSet(menu, btn, open) {
					var nav = btn.closest('nav');
					if (!nav) return;
					var openIcon = nav.querySelector('.tc-menu-open');
					var closeIcon = nav.querySelector('.tc-menu-close');
					if (!openIcon || !closeIcon) return;
					if (open) {
						menu.classList.remove('hidden');
						openIcon.classList.add('hidden');
						closeIcon.classList.remove('hidden');
						btn.setAttribute('aria-expanded', 'true');
						var first = menu.querySelector('a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])');
						if (first) first.focus();
					} else {
						menu.classList.add('hidden');
						openIcon.classList.remove('hidden');
						closeIcon.classList.add('hidden');
						btn.setAttribute('aria-expanded', 'false');
						btn.focus();
					}
				}
				document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-mobile-menu-toggle]');
					if (!btn) return;
					var menuId = btn.getAttribute('data-mobile-menu-toggle');
					var nav = btn.closest('nav');
					if (!nav) return;
					var menu = nav.querySelector('[data-mobile-menu-id="' + menuId + '"]');
					if (!menu) return;
					tcMobileMenuSet(menu, btn, menu.classList.contains('hidden'));
				});
				document.addEventListener('keydown', function(e) {
					if (e.key !== 'Escape') return;
					var menu = e.target.closest('[data-mobile-menu-id]');
					if (!menu) return;
					if (menu.classList.contains('hidden')) return;
					var menuId = menu.getAttribute('data-mobile-menu-id');
					var btn = document.querySelector('[data-mobile-menu-toggle="' + menuId + '"]');
					if (!btn) return;
					e.preventDefault();
					tcMobileMenuSet(menu, btn, false);
				});
			}
		</script></nav><div class="flex-1 lg:px-8 max-w-7xl mx-auto px-4 py-8 sm:px-6 w-full"><div class="mb-6"><div class="flex flex-wrap gap-4 items-center justify-between"><div class="min-w-0"><h1 class="break-after-avoid dark:text-white font-bold text-2xl text-gray-900 tracking-tight">Dashboard</h1><p class="dark:text-gray-400 mt-1 text-gray-500 text-sm">Index health and call quality at a glance</p></div><div class="flex-shrink-0"><button type="button" data-tc-copy="/dashboard?window=30" data-tc-copy-label="Copied!" class="bg-gray-50 cursor-pointer dark:bg-gray-700 dark:focus-visible:ring-blue-400 dark:hover:bg-gray-600 dark:ring-gray-600 dark:text-gray-200 focus-visible:ring-2 focus-visible:ring-blue-500 focus:outline-none font-medium gap-1.5 hover:bg-gray-100 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2.5 py-1 ring-1 ring-gray-300 ring-inset rounded-md text-gray-700 text-xs transition-colors" aria-label="Copy a shareable link to this dashboard view"><span data-tc-copy-text class="dark:text-gray-200 text-gray-700">Copy link</span></button> <span data-tc-copy-status role="status" class="sr-only"></span><script>
if(!window.tcCopyAttached){window.tcCopyAttached=true;function tcSwapLabel(el,label,original){if(el)el.textContent=label;setTimeout(function(){if(el)el.textContent=original;},2000);}function tcAnnounceCopy(btn,label){var st=btn.nextElementSibling;st=st&&st.hasAttribute('data-tc-copy-status')?st:null;if(st){st.textContent=label;setTimeout(function(){st.textContent='';},2000);}}function tcFallbackCopy(text,done){var ta=document.createElement('textarea');ta.value=text;ta.style.cssText='position:fixed;top:-9999px;left:-9999px';document.body.appendChild(ta);ta.focus();ta.select();try{document.execCommand('copy');done();}catch(e){}document.body.removeChild(ta);}document.addEventListener('click',function(e){var btn=e.target.closest('[data-tc-copy]');if(!btn)return;e.preventDefault();var text=btn.getAttribute('data-tc-copy');var label=btn.getAttribute('data-tc-copy-label')||'Copied!';var labelEl=btn.querySelector('[data-tc-copy-text]');var original=labelEl?labelEl.textContent:'';var done=function(){tcSwapLabel(labelEl,label,original);tcAnnounceCopy(btn,label);};if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done).catch(function(){tcFallbackCopy(text,done);});}else{tcFallbackCopy(text,done);}});}
</script>
