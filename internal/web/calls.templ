package web

import (
	"fmt"
	"net/url"
	"runtime/debug"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
)

func pageProps(nonce string, title string) layout.PageProps {
	props := layout.DefaultPageProps()
	props.Title = title
	// Per-request CSP nonce: Base stamps it on the theme script and the
	// self-hosted htmx script. Empty (nonce mode off) omits the attribute.
	props.Nonce = nonce
	// Signal palette in the mobile browser chrome (plan T16); the library
	// default is indigo. Dark matches the dark header (gray-900 #111827) —
	// the prop IS overridable at v1.21.0 (layout base_templ.go:43); the old
	// "library constant" comment here was stale (M11/F36 finding).
	props.ThemeColor = "#0f766e"
	props.DarkThemeColor = "#111827"
	// Self-host the htmx runtime (R9): polled regions need it, and the LAN
	// tool must not depend on a public CDN. Served at /static/htmx.min.js.
	props.HTMXSrc = "/static/htmx.min.js"

	return props
}

func nav(nonce string, currentPath string) templ.Component {
	return navigation.SimpleNav(navigation.SimpleNavProps{
		BaseProps: utils.BaseProps{
			Nonce: nonce,
			// Deterministic nav id (M8/F28 finding): with it empty, the
			// library's EnsureID mints a RANDOM id per render, every page
			// body is unique, and the ETag/no-cache revalidation contract
			// can never 304 — every poll and navigation is a full 200.
			ID: "pbx-lens-nav",
		},
		BrandText:   "pbx-lens",
		Links:       navLinks(),
		RightItems:  layout.ThemeToggle("Toggle theme", nonce),
		CurrentPath: currentPath,
	})
}

func navLinks() []navigation.NavLinkProps {
	return []navigation.NavLinkProps{
		{Href: "/", Text: "Calls"},
		{Href: "/search", Text: "Search"},
		{Href: "/dashboard", Text: "Dashboard"},
	}
}

// listPage renders the calls table with its filter form. Data honesty: the
// empty state explains HOW to fill the index, not just that it is empty.
templ listPage(page CallListPage, filters ListCallsQuery) {
	@display.PageHeader(display.PageHeaderProps{
		Title:    "Calls",
		Subtitle: "Every call the PBX ever saw",
		Action:   exportAction(),
	})
	@filterForm(filters, "/")
	if len(page.Rows) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "No calls match",
			Description: "No indexed call matches these filters. Widen them, or run an ingest command (ingest-cdr, ingest-telnyx, ingest-webhook, ingest-agent) against this DB and reload.",
			Icon:        icons.Inbox,
			ActionText:  "Clear filters",
			ActionHref:  "/",
		})
	} else {
		@display.ListNote(display.ListNoteProps{Variant: display.ListNoteCount, Shown: len(page.Rows)})
		@display.Table(tableProps(page.Rows))
		if page.NextOlder != "" || page.NextNewer != "" {
			@pagerRow(filters, page)
		}
		@exportHonestyNote()
	}
}

// exportHonestyNote is the export contract as visible text (plan T10.1):
// the header button's tooltip names it, but tooltips hide — an operator
// scanning the page sees the stall semantics spelled out under the table.
// The marker code is the machine-readable string consumers grep for; the
// rejection id names the stall class for the ops log.
templ exportHonestyNote() {
	<div class="mt-4 border-gray-200 border-t px-4 py-2.5 text-gray-500 text-xs dark:border-gray-700 dark:text-gray-400" role="note">
		Exports stream every matching call with no row cap. If a single
		timestamp groups more calls than one page can carry, the file ends
		with an <code>EXPORT_INCOMPLETE</code> marker
		(<code>lens.web.export_cursor_stalled</code>) instead of truncating
		silently — narrow the range with from/to and retry.
	</div>
}

// pagerRow is the two-direction keyset pager (plan T7). navigation.Pagination
// is page-NUMBER based and this list walks live keyset cursors — fabricating
// TotalPages would render lying links — so the pager renders as two library
// Buttons in a Pagination-shaped nav, disabled at each end of the walk.
// Filters ride both hrefs (listHref/listNewerHref) so a filtered walk stays
// filtered.
templ pagerRow(filters ListCallsQuery, page CallListPage) {
	<nav aria-label="Pagination" class="mt-4 flex items-center justify-between">
		<div>
			@display.Button(display.ButtonProps{
				Text:     "Newer calls",
				Href:     listNewerHref(filters, page.NextNewer),
				Variant:  display.ButtonSecondary,
				Icon:     icons.Icon("chevron-left", "size-4"),
				Disabled: page.NextNewer == "",
			})
		</div>
		<div>
			@display.Button(display.ButtonProps{
				Text:     "Older calls",
				Href:     listHref(filters, page.NextOlder),
				Variant:  display.ButtonSecondary,
				Icon:     icons.Icon("chevron-right", "size-4"),
				Disabled: page.NextOlder == "",
			})
		</div>
	</nav>
}

// exportAction surfaces the existing CSV export route in the page header
// (download attribute saves the file instead of navigating). The title is
// the export contract (plan T10): a stream that cannot make progress ends
// with a visible marker inside the file, never a silently truncated one.
templ exportAction() {
	@display.Button(display.ButtonProps{
		Text:    "Export CSV",
		Href:    "/api/export.csv",
		Variant: display.ButtonSecondary,
		Icon:    icons.Icon("download", "size-4"),
		Attrs:   templ.Attributes{"download": true, "title": "Streams every matching call. An export that cannot make progress ends with an EXPORT_INCOMPLETE marker row in the file."},
	})
}

// filterForm is the shared filter row (library Form, inline layout): GET
// submits server-side; the noscript world gets the Apply button.
templ filterForm(filters ListCallsQuery, action string) {
	@forms.Form(forms.FormProps{
		Action: action,
		Method: forms.FormGet,
		Layout: forms.FormLayoutInline,
		Class:  "mb-6",
	}) {
		@forms.Select(forms.SelectProps{
			Name:  "direction",
			Label: "Direction",
			// "All" (value "") is the unfiltered state the browser would
			// otherwise fake by rendering the first option as chosen.
			Options: []forms.SelectOption{
				{Value: "", Label: "All", Selected: filters.Direction == ""},
				{Value: "inbound", Label: "Inbound", Selected: filters.Direction == "inbound"},
				{Value: "outbound", Label: "Outbound", Selected: filters.Direction == "outbound"},
			},
			BaseProps: utils.BaseProps{Class: "w-36"},
		})
		@forms.Select(forms.SelectProps{
			Name:  "ai",
			Label: "Who",
			Options: []forms.SelectOption{
				{Value: "", Label: "All", Selected: aiValue(filters.AI) == ""},
				{Value: "yes", Label: "AI", Selected: aiValue(filters.AI) == "yes"},
				{Value: "no", Label: "Human", Selected: aiValue(filters.AI) == "no"},
			},
			BaseProps: utils.BaseProps{Class: "w-36"},
		})
		@forms.DatePicker(forms.DatePickerProps{
			Name:      "from",
			Label:     "From",
			Value:     dateValue(filters.From),
			BaseProps: utils.BaseProps{Class: "w-40"},
		})
		@forms.DatePicker(forms.DatePickerProps{
			Name:      "to",
			Label:     "To",
			Value:     dateValue(filters.To),
			BaseProps: utils.BaseProps{Class: "w-40"},
		})
		@display.Button(display.ButtonProps{Text: "Apply", Type: display.ButtonHTMLSubmit})
		if hasFilters(filters) {
			@display.Button(display.ButtonProps{Text: "Reset", Href: action, Variant: display.ButtonGhost})
		}
	}
}

// staleBanner is the freshness alert (T12): warning when the newest indexed
// call is older than the staleness threshold.
templ staleBanner(staleFor time.Duration) {
	@feedback.Alert(feedback.AlertProps{
		Type:    feedback.FeedbackWarning,
		Title:   "Index may be stale",
		Message: "Newest indexed call is " + compactDuration(staleFor) + " old — run the poller or an ingest command.",
	})
}

func aiValue(ai *bool) string {
	if ai == nil {
		return ""
	}

	if *ai {
		return "yes"
	}

	return "no"
}

func hasFilters(filters ListCallsQuery) bool {
	return filters.Direction != "" || filters.AI != nil ||
		!filters.From.IsZero() || !filters.To.IsZero() ||
		!filters.Before.IsZero() || !filters.After.IsZero()
}

func dateValue(t time.Time) string {
	if t.IsZero() {
		return ""
	}

	return t.Format("2006-01-02")
}

// tableProps builds the typed rows: display components in cells, the whole
// row clickable through Table's Href support (keyboard-navigable).
func tableProps(rows []CallRow) display.TableProps {
	out := display.TableProps{
		Headers:     []string{"When", "From", "To", "Direction", "Who", "Duration", "Opening line"},
		Striped:     true,
		Hover:       true,
		CellPadding: display.TableCellPaddingCompact,
		LazyRows:    true,
		Rows:        make([]display.TableRow, 0, len(rows)),
	}

	for _, row := range rows {
		out.Rows = append(out.Rows, display.TableRow{
			Href: row.Href(),
			Cells: []display.TableCell{
				{Content: display.RelativeTime(display.RelativeTimeProps{Time: row.When})},
				{Text: stringOrDash(row.From)},
				{Text: stringOrDash(row.To)},
				{Content: directionBadge(string(row.Direction))},
				{Content: whoBadge(row.IsAI)},
				{Text: clockDuration(row.Duration)},
				{Text: stringOrDash(row.Excerpt)},
			},
		})
	}

	return out
}

func directionBadge(direction string) templ.Component {
	if direction == "inbound" {
		return display.Badge(display.BadgeProps{Text: "inbound", Type: display.BadgeInfo, Pill: true})
	}

	return display.Badge(display.BadgeProps{Text: "outbound", Type: display.BadgeSuccess, Pill: true})
}

func whoBadge(isAI bool) templ.Component {
	if isAI {
		return display.Badge(display.BadgeProps{Text: "AI", Type: display.BadgePrimary, Pill: true})
	}

	return display.Badge(display.BadgeProps{Text: "Human", Type: display.BadgeNeutral, Pill: true})
}

// listHref preserves active filters across the older-keyset walk.
func listHref(filters ListCallsQuery, before string) string {
	return listPageHref(filters, "before", before)
}

// listNewerHref preserves active filters across the newer-keyset walk.
func listNewerHref(filters ListCallsQuery, after string) string {
	return listPageHref(filters, "after", after)
}

// listPageHref renders one list URL: the typed filters plus a single walk
// cursor under the given parameter name.
func listPageHref(filters ListCallsQuery, param string, value string) string {
	query := make(url.Values)
	if filters.Direction != "" {
		query.Set("direction", string(filters.Direction))
	}

	if v := aiValue(filters.AI); v != "" {
		query.Set("ai", v)
	}

	if !filters.From.IsZero() {
		query.Set("from", dateValue(filters.From))
	}

	if !filters.To.IsZero() {
		query.Set("to", dateValue(filters.To))
	}

	if value != "" {
		query.Set(param, value)
	}

	if len(query) == 0 {
		return "/"
	}

	return "/?" + query.Encode()
}

// filtersQueryString serializes the full typed query (filters + walk
// cursors) as a fragment-URL suffix: "" or "?…". Used by the staleness
// poll region so the fragment re-checks the view actually on screen.
func filtersQueryString(filters ListCallsQuery) string {
	query := make(url.Values)
	if filters.Direction != "" {
		query.Set("direction", string(filters.Direction))
	}

	if v := aiValue(filters.AI); v != "" {
		query.Set("ai", v)
	}

	if !filters.From.IsZero() {
		query.Set("from", dateValue(filters.From))
	}

	if !filters.To.IsZero() {
		query.Set("to", dateValue(filters.To))
	}

	if !filters.Before.IsZero() {
		query.Set("before", filters.Before.UTC().Format(time.RFC3339))
	}

	if !filters.After.IsZero() {
		query.Set("after", filters.After.UTC().Format(time.RFC3339))
	}

	if len(query) == 0 {
		return ""
	}

	return "?" + query.Encode()
}

// stringOrDash renders an empty participant/excerpt as an em dash — real
// CDRs carry unknown parties and the table must say so honestly.
func stringOrDash(s string) string {
	if s == "" {
		return "—"
	}

	return s
}

// clockDuration renders 3:45 / 1:02:03 display durations.
func clockDuration(d time.Duration) string {
	if d < 0 {
		d = 0
	}

	total := int(d.Seconds())
	hours, rem := total/3600, total%3600
	minutes, seconds := rem/60, rem%60

	if hours > 0 {
		return fmt.Sprintf("%d:%02d:%02d", hours, minutes, seconds)
	}

	return fmt.Sprintf("%d:%02d", minutes, seconds)
}

// compactDuration renders operator-style durations (42s, 1m30s) for the
// staleness banner.
func compactDuration(d time.Duration) string {
	rounded := d.Round(time.Second)
	if rounded < time.Minute {
		return rounded.String()
	}

	minutes := int(rounded.Minutes())
	if minutes < 60 {
		return fmt.Sprintf("%dm%02ds", minutes, int(rounded.Seconds())%60)
	}

	return fmt.Sprintf("%dh%02dm", int(rounded.Hours()), minutes%60)
}

// buildVersion extracts an honest short version from Go build info: the
// module version when built as a dependency-style binary, otherwise the
// vcs revision; empty when neither exists (nix store builds without VCS
// stamping) so the footer never shows a placeholder lie.
func buildVersion() string {
	info, ok := debug.ReadBuildInfo()
	if !ok {
		return ""
	}

	if info.Main.Version != "" && info.Main.Version != "(devel)" {
		return "v" + info.Main.Version
	}

	var revision string

	for _, setting := range info.Settings {
		if setting.Key == "vcs.revision" {
			revision = setting.Value

			break
		}
	}

	if len(revision) >= 7 {
		return revision[:7]
	}

	return ""
}
