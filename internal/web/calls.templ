package web

import (
	"fmt"
	"net/url"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils"
)

func pageProps(title string) layout.PageProps {
	props := layout.DefaultPageProps()
	props.Title = title
	// Self-host the htmx runtime (R9): polled regions need it, and the LAN
	// tool must not depend on a public CDN. Served at /static/htmx.min.js.
	props.HTMXSrc = "/static/htmx.min.js"

	return props
}

func nav(currentPath string) templ.Component {
	return navigation.SimpleNav(navigation.SimpleNavProps{
		BrandText:   "pbx-lens",
		Links:       navLinks(),
		RightItems:  layout.ThemeToggle("Toggle theme", ""),
		CurrentPath: currentPath,
	})
}

func navLinks() []navigation.NavLinkProps {
	return []navigation.NavLinkProps{
		{Href: "/", Text: "Calls"},
		{Href: "/search", Text: "Search"},
		{Href: "/dashboard", Text: "Dashboard"},
	}
}

// listPage renders the calls table with its filter form. Data honesty: the
// empty state explains HOW to fill the index, not just that it is empty.
templ listPage(page CallListPage, filters ListCallsQuery) {
	@display.PageHeader(display.PageHeaderProps{
		Title:    "Calls",
		Subtitle: "Every call the PBX ever saw",
		Action:   exportAction(),
	})
	@filterForm(filters, "/")
	if len(page.Rows) == 0 {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "No calls match",
			Description: "No indexed call matches these filters. Widen them, or run an ingest command (ingest-cdr, ingest-telnyx, ingest-webhook, ingest-agent) against this DB and reload.",
			Icon:        icons.Inbox,
		})
	} else {
		@display.ListNote(display.ListNoteProps{Variant: display.ListNoteCount, Shown: len(page.Rows)})
		@display.Table(tableProps(page.Rows))
		if page.NextOlder != "" {
			<div class="mt-4">
				@display.Button(display.ButtonProps{
					Text: "Older calls",
					Href: listHref(filters, page.NextOlder),
				})
			</div>
		}
	}
}

// exportAction surfaces the existing CSV export route in the page header
// (download attribute saves the file instead of navigating).
templ exportAction() {
	@display.Button(display.ButtonProps{
		Text:    "Export CSV",
		Href:    "/api/export.csv",
		Variant: display.ButtonSecondary,
		Icon:    icons.Icon("download", "size-4"),
		Attrs:   templ.Attributes{"download": true},
	})
}

// filterForm is the shared filter row (library Form, inline layout): GET
// submits server-side; the noscript world gets the Apply button.
templ filterForm(filters ListCallsQuery, action string) {
	@forms.Form(forms.FormProps{
		Action: action,
		Method: forms.FormGet,
		Layout: forms.FormLayoutInline,
		Class:  "mb-6",
	}) {
		@forms.Select(forms.SelectProps{
			Name:  "direction",
			Label: "Direction",
			Options: []forms.SelectOption{
				{Value: "inbound", Label: "Inbound", Selected: filters.Direction == "inbound"},
				{Value: "outbound", Label: "Outbound", Selected: filters.Direction == "outbound"},
			},
			BaseProps: utils.BaseProps{Class: "w-36"},
		})
		@forms.Select(forms.SelectProps{
			Name:  "ai",
			Label: "Who",
			Options: []forms.SelectOption{
				{Value: "yes", Label: "AI", Selected: aiValue(filters.AI) == "yes"},
				{Value: "no", Label: "Human", Selected: aiValue(filters.AI) == "no"},
			},
			BaseProps: utils.BaseProps{Class: "w-36"},
		})
		@forms.DatePicker(forms.DatePickerProps{
			Name:      "from",
			Label:     "From",
			Value:     dateValue(filters.From),
			BaseProps: utils.BaseProps{Class: "w-40"},
		})
		@forms.DatePicker(forms.DatePickerProps{
			Name:  "to",
			Label: "To",
			Value: dateValue(filters.To),
		})
		@display.Button(display.ButtonProps{Text: "Apply", Type: display.ButtonHTMLSubmit})
		if hasFilters(filters) {
			@display.Button(display.ButtonProps{Text: "Reset", Href: action, Variant: display.ButtonGhost})
		}
	}
}

// staleBanner is the freshness alert (T12): warning when the newest indexed
// call is older than the staleness threshold.
templ staleBanner(staleFor time.Duration) {
	@feedback.Alert(feedback.AlertProps{
		Type:    feedback.FeedbackWarning,
		Title:   "Index may be stale",
		Message: "Newest indexed call is " + compactDuration(staleFor) + " old — run the poller or an ingest command.",
	})
}

func aiValue(ai *bool) string {
	if ai == nil {
		return ""
	}

	if *ai {
		return "yes"
	}

	return "no"
}

func hasFilters(filters ListCallsQuery) bool {
	return filters.Direction != "" || filters.AI != nil ||
		!filters.From.IsZero() || !filters.To.IsZero() || !filters.Before.IsZero()
}

func dateValue(t time.Time) string {
	if t.IsZero() {
		return ""
	}

	return t.Format("2006-01-02")
}

// tableProps builds the typed rows: display components in cells, the whole
// row clickable through Table's Href support (keyboard-navigable).
func tableProps(rows []CallRow) display.TableProps {
	out := display.TableProps{
		Headers: []string{"When", "From", "To", "Direction", "Who", "Duration", "Opening line"},
		Striped: true,
		Hover:   true,
		Rows:    make([]display.TableRow, 0, len(rows)),
	}

	for _, row := range rows {
		out.Rows = append(out.Rows, display.TableRow{
			Href: row.Href(),
			Cells: []display.TableCell{
				{Content: display.RelativeTime(display.RelativeTimeProps{Time: row.When})},
				{Text: stringOrDash(row.From)},
				{Text: stringOrDash(row.To)},
				{Content: directionBadge(string(row.Direction))},
				{Content: whoBadge(row.IsAI)},
				{Text: clockDuration(row.Duration)},
				{Text: stringOrDash(row.Excerpt)},
			},
		})
	}

	return out
}

func directionBadge(direction string) templ.Component {
	if direction == "inbound" {
		return display.Badge(display.BadgeProps{Text: "inbound", Type: display.BadgeInfo, Pill: true})
	}

	return display.Badge(display.BadgeProps{Text: "outbound", Type: display.BadgeSuccess, Pill: true})
}

func whoBadge(isAI bool) templ.Component {
	if isAI {
		return display.Badge(display.BadgeProps{Text: "AI", Type: display.BadgePrimary, Pill: true})
	}

	return display.Badge(display.BadgeProps{Text: "Human", Type: display.BadgeNeutral, Pill: true})
}

// listHref preserves active filters across the keyset walk.
func listHref(filters ListCallsQuery, before string) string {
	query := make(url.Values)
	if filters.Direction != "" {
		query.Set("direction", string(filters.Direction))
	}

	if v := aiValue(filters.AI); v != "" {
		query.Set("ai", v)
	}

	if !filters.From.IsZero() {
		query.Set("from", dateValue(filters.From))
	}

	if !filters.To.IsZero() {
		query.Set("to", dateValue(filters.To))
	}

	if before != "" {
		query.Set("before", before)
	}

	if len(query) == 0 {
		return "/"
	}

	return "/?" + query.Encode()
}

// stringOrDash renders an empty participant/excerpt as an em dash — real
// CDRs carry unknown parties and the table must say so honestly.
func stringOrDash(s string) string {
	if s == "" {
		return "—"
	}

	return s
}

// clockDuration renders 3:45 / 1:02:03 display durations.
func clockDuration(d time.Duration) string {
	if d < 0 {
		d = 0
	}

	total := int(d.Seconds())
	hours, rem := total/3600, total%3600
	minutes, seconds := rem/60, rem%60

	if hours > 0 {
		return fmt.Sprintf("%d:%02d:%02d", hours, minutes, seconds)
	}

	return fmt.Sprintf("%d:%02d", minutes, seconds)
}

// compactDuration renders operator-style durations (42s, 1m30s) for the
// staleness banner.
func compactDuration(d time.Duration) string {
	rounded := d.Round(time.Second)
	if rounded < time.Minute {
		return rounded.String()
	}

	minutes := int(rounded.Minutes())
	if minutes < 60 {
		return fmt.Sprintf("%dm%02ds", minutes, int(rounded.Seconds())%60)
	}

	return fmt.Sprintf("%dh%02dm", int(rounded.Hours()), minutes%60)
}
