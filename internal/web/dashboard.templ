package web

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/format"
)

// copyLinkAction is the canonical share-link affordance (plan P14): the
// path+query that reconstructs the current view, copied as text. The server
// builds it — never window.location — so it stays free of volatile params.
func copyLinkAction(nonce string, ariaLabel string, path string) templ.Component {
	return display.CopyButton(display.CopyButtonProps{
		Text:      path,
		Label:     "Copy link",
		AriaLabel: ariaLabel,
		Nonce:     nonce,
	})
}

// canonicalDashboardPath is the shareable address of the current dashboard
// view (plan P14): the window preset and/or the active date range — the
// exact inputs the page reads back — and nothing else.
func canonicalDashboardPath(stats DashboardStats) string {
	query := make(url.Values)

	if stats.WindowDays == 7 || stats.WindowDays == 30 {
		query.Set("window", strconv.Itoa(stats.WindowDays))
	}

	if !stats.rangeFrom.IsZero() {
		query.Set("from", dateValue(stats.rangeFrom))
	}

	if !stats.rangeTo.IsZero() {
		query.Set("to", dateValue(stats.rangeTo))
	}

	if len(query) == 0 {
		return "/dashboard"
	}

	return "/dashboard?" + query.Encode()
}

// dashboardRoute is the quality-dashboard page (T25): a date-range picker,
// then the live cards region (stat cards, volume, AI/human split, trend,
// durations, MOS).
templ dashboardRoute(nonce string, stats DashboardStats, now time.Time, fragURL string) {
	@shell(nonce, "Dashboard — pbx-lens", "/dashboard") {
		@display.PageHeader(display.PageHeaderProps{
			Title:    "Dashboard",
			Subtitle: "Index health and call quality at a glance",
			Action:   copyLinkAction(nonce, "Copy a shareable link to this dashboard view", canonicalDashboardPath(stats)),
		})
		@windowPresets(stats)
		@rangeForm(stats)
		@dashboardLive(nonce, stats, now, fragURL)
	}
}

// windowPresets is the 7/30-day quick pick (plan T12): links re-query the
// dashboard with the preset window; the active one renders filled so the
// chart span is never ambiguous.
templ windowPresets(stats DashboardStats) {
	<div class="mb-3 flex items-center gap-2">
		@display.Button(display.ButtonProps{
			Text:    "Last 7 days",
			Href:    "/dashboard?window=7",
			Variant: utils.Ternary(stats.WindowDays == 7, display.ButtonPrimary, display.ButtonGhost),
			Size:    display.ButtonSizeSM,
		})
		@display.Button(display.ButtonProps{
			Text:    "Last 30 days",
			Href:    "/dashboard?window=30",
			Variant: utils.Ternary(stats.WindowDays == 30, display.ButtonPrimary, display.ButtonGhost),
			Size:    display.ButtonSizeSM,
		})
	</div>
}

// rangeForm narrows the whole dashboard to a date range (R8/M20.1).
// Library Form in inline layout: GET submits server-side; the noscript
// world submits it like the list filters.
templ rangeForm(stats DashboardStats) {
	@forms.Form(forms.FormProps{
		Action: "/dashboard",
		Method: forms.FormGet,
		Layout: forms.FormLayoutInline,
		Class:  "mb-6",
	}) {
		@forms.DatePicker(forms.DatePickerProps{
			Name:      "from",
			Label:     "From",
			Value:     dateValue(stats.rangeFrom),
			BaseProps: utils.BaseProps{Class: "w-40"},
		})
		@forms.DatePicker(forms.DatePickerProps{
			Name:      "to",
			Label:     "To",
			Value:     dateValue(stats.rangeTo),
			BaseProps: utils.BaseProps{Class: "w-40"},
		})
		@display.Button(display.ButtonProps{Text: "Apply", Type: display.ButtonHTMLSubmit})
		@display.Button(display.ButtonProps{Text: "Reset", Href: "/dashboard", Variant: display.ButtonGhost})
	}
}

// dashboardLive is the polled cards region (R9): htmx re-fetches fragURL
// every 30s and swaps the whole region, so the numbers go stale for at
// most one interval. The timestamp footer is the liveness pill — when it
// freezes, polling has stalled. Without JS the server-rendered content is
// the same fallback the page always had.
//
// The pill clock is minute-quantized (the library Now hook): a wall-clock
// second-resolution stamp changed the body every second, so the ETag
// rotated every second and every poll answered 200 — the liveness pill
// was silently defeating the route's revalidation economy
// (docs/http-stack.md). Truncated to the minute it still visibly ticks,
// and the body stays byte-stable between minute boundaries.
templ dashboardLive(nonce string, stats DashboardStats, now time.Time, fragURL string) {
	@htmx.PolledRegion(htmx.PolledRegionProps{
		URL:           fragURL,
		Every:         "30s",
		ShowTimestamp: true,
		Now:           func() time.Time { return now.Truncate(time.Minute) },
	}) {
		@statCards(stats, now)
		@layout.Split(layout.SplitProps{
			Main:  dashboardMain(nonce, stats),
			Aside: dashboardAside(stats),
		})
	}
}

// dashboardMain is the Split's wide column: volume, durations, then the
// hour-by-weekday density heatmap.
templ dashboardMain(nonce string, stats DashboardStats) {
	@layout.Stack(layout.StackProps{Gap: layout.StackGapLG}) {
		@volumeCard(stats)
		@durationCard(stats)
		@segmentsCard(nonce, stats)
		@qualityCard(stats)
		@heatmapCard(stats)
	}
}

// qualityCard is north-star slice 3 (plan T8): how the window's calls ended,
// plus the truth signals the detail page shows one call at a time. Every rate
// names its own denominator in the "Of" column — a rate over the wrong
// population is worse than no rate at all.
templ qualityCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "How calls end", TitleTag: display.HeadingTagH2}) {
		if stats.Total == 0 {
			@display.SimpleEmptyState("No calls in the window yet.")
		} else {
			if stats.QualityTrend.HasBaseline {
				<p class="mb-3 text-xs text-gray-500 dark:text-gray-400">{ qualityTrendLabel(stats) }</p>
			}
			<div class="gap-6 grid md:grid-cols-2">
				<div>
					<h3 class="break-after-avoid dark:text-white font-medium leading-6 text-gray-900 text-sm">
						Hangup causes
					</h3>
					<div class="mt-2">
						@display.BarChart(display.BarChartProps{
							Bars:         hangupBars(stats.Quality.HangupCauses, stats.Quality.Calls),
							Orient:       display.BarHorizontal,
							ShowValues:   true,
							EmptyMessage: "No hangup causes recorded",
						})
					</div>
				</div>
				<div>
					<h3 class="break-after-avoid dark:text-white font-medium leading-6 text-gray-900 text-sm">
						Source truths
					</h3>
					<div class="mt-2">
						@display.Table(display.TableProps{
							Headers:     []string{"Signal", "Calls", "Of", "Share"},
							Striped:     true,
							CellPadding: display.TableCellPaddingCompact,
							Rows:        signalRows(stats.Quality),
						})
					</div>
				</div>
			</div>
		}
	}
}

// hangupBars maps the ordered causes onto chart bars; the tooltip carries the
// exact count and share, so the bar length never has to be read precisely.
func hangupBars(causes []HangupCauseCount, total int) []display.BarChartBar {
	bars := make([]display.BarChartBar, 0, len(causes))

	for _, cause := range causes {
		tooltip := strconv.Itoa(cause.Calls) + " calls"
		if ratio, ok := Rate(cause.Calls, total); ok {
			tooltip += " (" + format.Percent(ratio) + ")"
		}

		bars = append(bars, display.BarChartBar{
			Label:   cause.Cause,
			Value:   float64(cause.Calls),
			Tooltip: cause.Cause + ": " + tooltip,
		})
	}

	return bars
}

// signalRows renders the three standing rates with their populations spelled
// out: "Calls" over "Of". A zero denominator renders an em dash, never 0%.
func signalRows(rollup QualityRollup) []display.TableRow {
	return []display.TableRow{
		signalRow("No user turn", rollup.NoUserTurn, rollup.Transcripts, "transcript", "transcripts"),
		signalRow("Self-dial", rollup.SelfDial, rollup.PartiesKnown, "call with both parties", "calls with both parties"),
		signalRow("Recording tail ≥ 20 s", rollup.RecordingTail, rollup.TailEligible, "timed transcript", "timed transcripts"),
	}
}

// signalRow renders one rate with its population named, so "1" never has to
// be read without knowing what it is one OF.
func signalRow(label string, count, denominator int, singular, plural string) display.TableRow {
	share := "—"
	if ratio, ok := Rate(count, denominator); ok {
		share = format.Percent(ratio)
	}

	population := plural
	if denominator == 1 {
		population = singular
	}

	return display.TableRow{
		Cells: []display.TableCell{
			{Text: label},
			{Text: strconv.Itoa(count)},
			{Text: strconv.Itoa(denominator) + " " + population},
			{Text: share},
		},
	}
}

// segmentsCard is north-star slice 2 (plan T7): the window's traffic split by
// OUR numbers and by the outside party, each row a drill-through into the
// filtered call list. It answers "who calls what", the question the operator
// asks first and the UI could not answer at all.
templ segmentsCard(nonce string, stats DashboardStats) {
	@display.Card(display.CardProps{Title: "Who calls what", TitleTag: display.HeadingTagH2}) {
		if len(stats.TopNumbers) == 0 && len(stats.TopPeers) == 0 {
			@display.SimpleEmptyState("No numbers in the window yet.")
		} else {
			<h3 class="break-after-avoid dark:text-white font-medium leading-6 text-gray-900 text-sm">
				Our numbers
			</h3>
			<div class="mt-2">
				@segmentTable(nonce, stats.TopNumbers)
			</div>
			<h3 class="break-after-avoid dark:text-white font-medium leading-6 mt-6 text-gray-900 text-sm">
				Counterparties
			</h3>
			<div class="mt-2">
				@segmentTable(nonce, stats.TopPeers)
			</div>
		}
	}
}

// segmentTable renders one breakdown. Rows carry the number filter as their
// href, so a click narrows the list instead of leaving the operator to retype
// the number.
templ segmentTable(nonce string, segments []Segment) {
	if len(segments) == 0 {
		<p class="dark:text-gray-400 text-gray-500 text-sm">No calls in this window.</p>
	} else {
		@display.Table(display.TableProps{
			Headers:     []string{"Number", "Calls", "AI", "Avg", "Spend", "Rate"},
			Striped:     true,
			Hover:       true,
			CellPadding: display.TableCellPaddingCompact,
			LazyRows:    true,
			Nonce:       nonce,
			Rows:        segmentRows(segments),
		})
	}
}

// segmentRows maps the typed segments onto display rows. Spend and Rate
// render only when the segment actually carried prices (never a confident
// zero); the rate divides by the priced calls' own seconds, matching the
// window rate's denominator discipline.
func segmentRows(segments []Segment) []display.TableRow {
	rows := make([]display.TableRow, 0, len(segments))

	for _, segment := range segments {
		spend := "—"
		if segment.HasCost() {
			spend = costText(segment.CostMicros, "")
		}

		rate := "—"
		if segment.HasRate() {
			rate = strconv.FormatFloat(segment.CostPerMinute(), 'f', 3, 64) + "/min"
		}

		rows = append(rows, display.TableRow{
			Href: segment.Href(),
			Cells: []display.TableCell{
				{Text: segment.Number},
				{Text: strconv.Itoa(segment.Calls)},
				{Text: format.Percent(segment.AIRatio())},
				{Text: format.ClockDuration(segment.AvgDuration())},
				{Text: spend},
				{Text: rate},
			},
		})
	}

	return rows
}

// heatmapCard is the "when do calls happen" density grid (plan T19):
// weekday rows x hour columns in the dashboard zone. A quiet window renders
// the honest empty message instead of a wall of near-invisible cells, and
// the weekday baseline note (plan P12) sits quietly under the grid.
templ heatmapCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "Call density (weekday × hour)", TitleTag: display.HeadingTagH2}) {
		if stats.Total == 0 {
			<p class="text-sm text-gray-500 dark:text-gray-400">
				No calls in the last { strconv.Itoa(stats.WindowDays) } days.
			</p>
		} else {
			@display.Heatmap(display.HeatmapProps{
				Rows:          heatmapRows(stats),
				ColumnLabels:  heatmapColumnLabels(),
				HighlightPeak: true,
				AriaLabel:     "Call density by weekday and hour (" + strconv.Itoa(stats.WindowDays) + "-day window, dashboard zone)",
				CellSize:      "w-3",
			})
			@volumeNoteLine(stats.VolumeNote)
		}
	}
}

// volumeNoteLine renders the anomaly-baseline verdict as one quiet line —
// prose, not a chart: the number is already on the grid above.
templ volumeNoteLine(note VolumeNote) {
	if note.Kind == VolumeNoHistory {
		<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
			Not enough history yet for a usual-range note (needs two full weeks).
		</p>
	} else if note.Kind == VolumeUsual {
		<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
			Today so far: { strconv.Itoa(note.Today) } call(s), usual for a { note.Weekday } (typically { strconv.Itoa(note.Low) }-{ strconv.Itoa(note.High) }).
		</p>
	} else if note.Kind == VolumeQuiet {
		<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
			Today so far: { strconv.Itoa(note.Today) } call(s), unusually quiet for a { note.Weekday } (typically { strconv.Itoa(note.Low) }-{ strconv.Itoa(note.High) }).
		</p>
	} else if note.Kind == VolumeBusy {
		<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
			Today so far: { strconv.Itoa(note.Today) } call(s), unusually busy for a { note.Weekday } (typically { strconv.Itoa(note.Low) }-{ strconv.Itoa(note.High) }).
		</p>
	}
}

// heatmapRows maps the accumulator buckets onto Heatmap rows, Mon-first.
func heatmapRows(stats DashboardStats) []display.HeatmapRow {
	weekdays := []string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
	rows := make([]display.HeatmapRow, 0, len(weekdays))

	for wd, label := range weekdays {
		cells := make([]display.HeatmapCell, 0, 24)

		for hour, count := range stats.HourDay[wd] {
			cells = append(cells, display.HeatmapCell{
				Value: float64(count),
				Label: fmt.Sprintf("%s %02d:00 · %d call(s)", label, hour, count),
			})
		}

		rows = append(rows, display.HeatmapRow{Label: label, Cells: cells})
	}

	return rows
}

// heatmapColumnLabels labels every third hour; a 24-column axis only stays
// readable with sparse labels.
func heatmapColumnLabels() []string {
	labels := make([]string, 0, 24)

	for hour := range 24 {
		if hour%3 == 0 {
			labels = append(labels, fmt.Sprintf("%02d", hour))
		} else {
			labels = append(labels, "")
		}
	}

	return labels
}

// dashboardAside is the Split's narrow column: mix, spend, trend, quality.
templ dashboardAside(stats DashboardStats) {
	@layout.Stack(layout.StackProps{Gap: layout.StackGapLG}) {
		@aiHumanCard(stats)
		@spendCard(stats)
		@trendCard(stats)
		@mosCard(stats)
	}
}

// spendCard is north-star slice 1 (plan T6): what the window cost, at what
// rate, and how that moved against the previous week. Every figure carries its
// own denominator, so a window with no priced calls renders the honest empty
// state instead of a 0-spend claim (Verschlimmbesserung guard 3).
templ spendCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "Spend", TitleTag: display.HeadingTagH2}) {
		if !stats.HasCostData() {
			@display.SimpleEmptyState("No cost data yet — prices arrive with the Telnyx Detail Records.")
		} else {
			<div class="flex items-baseline justify-between gap-3">
				<span class="text-3xl font-semibold tabular-nums text-gray-900 dark:text-gray-100">
					{ costText(stats.CostMicros, stats.CostCurrency) }
				</span>
				<span class="text-sm tabular-nums text-gray-600 dark:text-gray-300">
					{ costPerMinuteText(stats) }
				</span>
			</div>
			<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{ pricedCallsText(stats) }</p>
			if stats.CostWeek.HasBaseline {
				<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{ weekChangeLabel(stats.CostWeek) }</p>
			}
			<div class="mt-3">
				@display.Sparkline(display.SparklineProps{
					Values:    stats.DailyCost(),
					Filled:    true,
					Width:     260,
					Height:    40,
					AriaLabel: "Spend per day over the last " + strconv.Itoa(stats.WindowDays) + " days",
				})
			</div>
		}
	}
}

// pricedCallsText states the denominator: how many of the window's calls
// actually carried a price. A rate over an unknown subset is not a rate.
func pricedCallsText(stats DashboardStats) string {
	return strconv.Itoa(stats.CostKnown) + " of " + strconv.Itoa(stats.Total) + " calls priced"
}

// costPerMinuteText renders the mean spend per billed minute. Three decimals
// keep sub-cent rates legible without faking precision.
func costPerMinuteText(stats DashboardStats) string {
	return strconv.FormatFloat(stats.CostPerMinute(), 'f', 3, 64) + " " + currencyLabel(stats.CostCurrency) + "/min"
}

// currencyLabel renders the window's currency, and says so when the priced
// calls disagree (their totals are then unit-less by construction).
func currencyLabel(currency string) string {
	if currency == "" {
		return "mixed"
	}

	return currency
}

// statCards is the headline row: total, today, AI share, average duration.
// Empty-index honesty: zero calls render 0 / "—", never a fake percentage.
templ statCards(stats DashboardStats, now time.Time) {
	@display.Grid(display.GridProps{Cols: display.GridCols4}) {
		@display.StatCard(display.StatCardProps{
			Value:  strconv.Itoa(stats.Total),
			Label:  "Calls indexed",
			Href:   "/",
			Icon:   icons.Phone,
			Change: weekChangeLabel(stats.Week),
			Trend:  weekTrend(stats.Week),
		})
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(stats.Today),
			Label: "Calls today",
			Href:  stats.todayHref(now),
			Icon:  icons.Calendar,
			Tone:  display.StatToneGreen,
		})
		@display.StatCard(display.StatCardProps{
			Value: aiShare(stats),
			Label: "AI share",
			Href:  "/?ai=yes",
			Icon:  icons.Microphone,
			Tone:  display.StatTonePurple,
		})
		@display.StatCard(display.StatCardProps{
			Value: format.ClockDuration(stats.AvgDuration),
			Label: "Avg duration",
			Icon:  icons.Clock,
			Tone:  display.StatToneYellow,
		})
	}
}

// volumeCard is the calls-per-day bar chart over the dashboard window,
// with the week-over-week delta underneath (R27).
templ volumeCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: volumeTitle(stats.WindowDays), TitleTag: display.HeadingTagH2}) {
		@display.BarChart(display.BarChartProps{
			Bars:   volumeBars(stats.ByDay),
			Orient: display.BarVertical,
			// Height + !items-stretch: without them the bar wrapper has no
			// definite height and every vertical bar collapses to 0 px
			// (verified in-browser; upstream file candidate).
			Height:       "10rem",
			Class:        "!items-stretch",
			MinBarWidth:  "min-w-1",
			Gap:          "gap-px",
			ShowValues:   false,
			EmptyMessage: "No calls in the last " + strconv.Itoa(stats.WindowDays) + " days",
		})
	}
}

// durationCard buckets call durations (R8/M20.2): how long calls actually
// run, independent of when they happened.
templ durationCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "Call durations", TitleTag: display.HeadingTagH2}) {
		@display.BarChart(display.BarChartProps{
			Bars:   durationBars(stats.Durations),
			Orient: display.BarVertical,
			Height: "10rem",
			Class:  "!items-stretch",
			// No printed values: five "0"s over empty buckets drown the one
			// number that matters, and the volume chart next to it reads
			// shape without values too — the tooltip carries the exact count.
			ShowValues:   false,
			EmptyMessage: "No calls indexed yet",
		})
	}
}

// durationBars maps the histogram buckets onto chart bars. An all-zero
// bucket set yields nil so the chart's EmptyMessage shows (the empty box of
// collapsed 0-px bars was an M3 eyeball finding, not an honest ladder).
func durationBars(buckets []DurationBucket) []display.BarChartBar {
	if len(buckets) == 0 || seriesAllZero(bucketValues(buckets)) {
		return nil
	}

	bars := make([]display.BarChartBar, 0, len(buckets))
	for _, bucket := range buckets {
		bars = append(bars, display.BarChartBar{
			Label:   bucket.Label,
			Value:   float64(bucket.Calls),
			Tooltip: bucket.Label + ": " + strconv.Itoa(bucket.Calls) + " calls",
		})
	}

	return bars
}

func bucketValues(buckets []DurationBucket) []float64 {
	values := make([]float64, 0, len(buckets))
	for _, bucket := range buckets {
		values = append(values, float64(bucket.Calls))
	}

	return values
}

// qualityTrendLabel states the no-user-turn share and its week-over-week
// move in points; the direction is spelled out because for this signal
// DOWN is the good direction, and an arrow alone would not say so.
func qualityTrendLabel(stats DashboardStats) string {
	ratio, ok := Rate(stats.Quality.NoUserTurn, stats.Quality.Transcripts)
	if !ok {
		return ""
	}

	share := format.Percent(ratio)
	points := stats.QualityTrend.Points
	switch {
	case points < 0:
		return "No-user-turn share " + share + ", down " + strconv.FormatFloat(-points, 'f', 1, 64) + " points vs the prior week"
	case points > 0:
		return "No-user-turn share " + share + ", up " + strconv.FormatFloat(points, 'f', 1, 64) + " points vs the prior week"
	default:
		return "No-user-turn share " + share + ", unchanged vs the prior week"
	}
}

// weekChangeLabel renders the week-over-week movement as a StatCard Change
// line (plan T13); the library renders the trend arrow.
func weekChangeLabel(delta WeekDelta) string {
	sign := "+"
	if delta.Pct < 0 {
		sign = ""
	}

	return fmt.Sprintf("%s%.0f%% vs last week", sign, delta.Pct)
}

// weekTrend maps the delta onto the library's trend arrow.
func weekTrend(delta WeekDelta) display.TrendDirection {
	switch {
	case !delta.HasBaseline || delta.Pct == 0:
		return display.TrendNone
	case delta.Pct > 0:
		return display.TrendUp

	default:
		return display.TrendDown
	}
}

// aiHumanCard is the AI-vs-human proportion: a donut chart (library
// PieChart, Donut mode) with the AI share in the center and an exact-count
// legend. Empty indexes get the chart's own honest empty message.
templ aiHumanCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "AI vs human", TitleTag: display.HeadingTagH2}) {
		@display.PieChart(display.PieChartProps{
			Slices: []display.PieChartSlice{
				{Label: "AI · " + strconv.Itoa(stats.AICalls), Value: float64(stats.AICalls), Color: "text-teal-600 dark:text-teal-400"},
				{Label: "Human · " + strconv.Itoa(stats.HumanCalls), Value: float64(stats.HumanCalls), Color: "text-gray-400 dark:text-gray-500"},
			},
			Donut:        true,
			CenterLabel:  aiShare(stats),
			ShowLegend:   true,
			EmptyMessage: "No calls indexed yet.",
		})
	}
}

// trendCard is the 30-day sparkline over the same series as the bar chart.
// Empty-index honesty (M3 finding): a flat zero sparkline reads as a broken
// chart, not as "quiet index" — the all-zero window explains itself instead.
templ trendCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "30-day trend", TitleTag: display.HeadingTagH2}) {
		if seriesAllZero(volumeValues(stats.ByDay)) {
			@display.SimpleEmptyState("No calls in the window yet.")
		} else {
			@display.Sparkline(display.SparklineProps{
				Values:    volumeValues(stats.ByDay),
				Filled:    true,
				Width:     260,
				Height:    60,
				AriaLabel: "Calls per day over the last " + strconv.Itoa(stats.WindowDays) + " days",
			})
		}
	}
}

// seriesAllZero reports whether every value is 0 (or the series is empty) —
// the "quiet window" test shared by the chart honesty ladder.
func seriesAllZero(values []float64) bool {
	for _, v := range values {
		if v != 0 {
			return false
		}
	}

	return true
}

// mosCard renders the mean MOS and per-day trend once any call reports a
// score; before the first MOS arrives it stays the honest placeholder so a
// quiet index never fakes a measurement.
templ mosCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "Call quality (MOS)", TitleTag: display.HeadingTagH2}) {
		if stats.MOSKnown == 0 {
			@feedback.Alert(feedback.AlertProps{
				Type:    feedback.FeedbackInfo,
				Title:   "Not available yet",
				Message: "No indexed call has reported a quality score yet. Once calls carry MOS data, this card shows the mean score and its trend.",
			})
		} else {
			<div class="flex items-center gap-4">
				@feedback.CircularProgress(feedback.CircularProgressProps{
					Value:     mosGaugePercent(stats.AvgMOS()),
					Size:      feedback.CircularProgressSizeLG,
					ShowLabel: false,
				})
				<div>
					<p class="text-2xl font-semibold">{ avgMOSLabel(stats) }</p>
					<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
						mean of { scoredCallsLabel(stats.MOSKnown) }
					</p>
				</div>
			</div>
			if hasWindowMOS(stats.ByDay) {
				<div class="mt-3">
					@display.BarChart(display.BarChartProps{
						Bars:         mosBars(stats.ByDay),
						Orient:       display.BarVertical,
						Height:       "6rem",
						Class:        "!items-stretch",
						MinBarWidth:  "min-w-1",
						Gap:          "gap-px",
						ShowValues:   false,
						EmptyMessage: "No MOS data in the last " + strconv.Itoa(stats.WindowDays) + " days",
					})
				</div>
			} else {
				<p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
					No MOS data in the last { strconv.Itoa(stats.WindowDays) } days.
				</p>
			}
		}
	}
}

// mosBars maps per-day mean MOS onto chart bars. A day without scores keeps
// its slot as an empty bar whose tooltip says so: a missing measurement must
// never render as a 0.0 dip in quality.
func mosBars(days []DayVolume) []display.BarChartBar {
	bars := make([]display.BarChartBar, 0, len(days))
	for _, day := range days {
		bar := display.BarChartBar{Value: day.AvgMOS()}
		if day.MOSKnown == 0 {
			bar.Tooltip = day.Day + ": no MOS data"
		} else {
			bar.Tooltip = day.Day + ": avg " + strconv.FormatFloat(day.AvgMOS(), 'f', 2, 64) +
				" (" + strconv.Itoa(day.MOSKnown) + " scored)"
		}

		bars = append(bars, bar)
	}

	return bars
}

func avgMOSLabel(stats DashboardStats) string {
	return strconv.FormatFloat(stats.AvgMOS(), 'f', 1, 64)
}

// hasWindowMOS reports whether any day inside the chart window carries a
// score; without it the chart shows nothing at all, so the card explains
// itself in text instead.
func hasWindowMOS(days []DayVolume) bool {
	for _, day := range days {
		if day.MOSKnown > 0 {
			return true
		}
	}

	return false
}

// scoredCallsLabel renders "N scored calls" with honest singular when the
// index holds exactly one measured call.
func scoredCallsLabel(known int) string {
	if known == 1 {
		return "1 scored call"
	}

	return strconv.Itoa(known) + " scored calls"
}

// volumeBars maps the day series onto chart bars (oldest → newest).
// Labels stay empty on this dense 30-bar axis — a date clipped to a 4 px
// column reads as litter; the tooltip carries the full date instead.
func volumeBars(days []DayVolume) []display.BarChartBar {
	if len(days) == 0 || seriesAllZero(volumeValues(days)) {
		return nil
	}

	bars := make([]display.BarChartBar, 0, len(days))
	for _, day := range days {
		bars = append(bars, display.BarChartBar{
			Value:   float64(day.Calls),
			Tooltip: day.Day + ": " + strconv.Itoa(day.Calls),
		})
	}

	return bars
}

// volumeValues is the same series as plain numbers for the sparkline.
func volumeValues(days []DayVolume) []float64 {
	values := make([]float64, 0, len(days))
	for _, day := range days {
		values = append(values, float64(day.Calls))
	}

	return values
}

func volumeTitle(windowDays int) string {
	return "Calls per day (last " + strconv.Itoa(windowDays) + " days)"
}

// aiShare renders the AI percentage, or an em dash when nothing is indexed
// (0 calls → "0.0%" would imply measurement, not absence).
func aiShare(stats DashboardStats) string {
	if stats.Total == 0 {
		return "—"
	}

	return format.Percent(stats.AIRatio())
}

// mosGaugePercent maps MOS (1–5) onto the 0–100 gauge: 1.0 bottoms out at
// 0%, 5.0 fills the ring. Values outside the scale clamp at the rails.
func mosGaugePercent(mos float64) int {
	const (
		mosFloor = 1.0
		mosCeil  = 5.0
	)

	clamped := min(max(mos, mosFloor), mosCeil)

	return int((clamped - mosFloor) / (mosCeil - mosFloor) * percentScale)
}
