package web

import (
	"strconv"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
)

// dashboardRoute is the quality-dashboard page (T25): stat cards, volume
// chart, AI/human split, trend, and the MOS card.
templ dashboardRoute(stats DashboardStats, now time.Time) {
	@shell("Dashboard — pbx-lens", "/dashboard") {
		@display.PageHeader(display.PageHeaderProps{
			Title:    "Dashboard",
			Subtitle: "Index health and call quality at a glance",
		})
		@statCards(stats, now)
		<div class="grid items-start gap-6 lg:grid-cols-3">
			<div class="lg:col-span-2">
				@volumeCard(stats)
			</div>
			<div class="space-y-6">
				@aiHumanCard(stats)
				@trendCard(stats)
				@mosCard(stats)
			</div>
		</div>
	}
}

// statCards is the headline row: total, today, AI share, average duration.
// Empty-index honesty: zero calls render 0 / "—", never a fake percentage.
templ statCards(stats DashboardStats, now time.Time) {
	@display.Grid(display.GridProps{Cols: display.GridCols4}) {
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(stats.Total),
			Label: "Calls indexed",
			Href:  "/",
		})
		@display.StatCard(display.StatCardProps{
			Value: strconv.Itoa(stats.Today),
			Label: "Calls today",
			Href:  stats.todayHref(now),
		})
		@display.StatCard(display.StatCardProps{
			Value: aiShare(stats),
			Label: "AI share",
			Href:  "/?ai=yes",
		})
		@display.StatCard(display.StatCardProps{
			Value: clockDuration(stats.AvgDuration),
			Label: "Avg duration",
		})
	}
}

// volumeCard is the calls-per-day bar chart over the dashboard window.
templ volumeCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: volumeTitle(stats.WindowDays)}) {
		@display.BarChart(display.BarChartProps{
			Bars:         volumeBars(stats.ByDay),
			Orient:       display.BarVertical,
			MinBarWidth:  "min-w-1",
			Gap:          "gap-px",
			ShowValues:   false,
			EmptyMessage: "No calls in the last " + strconv.Itoa(stats.WindowDays) + " days",
		})
	}
}

// aiHumanCard is the AI-vs-human proportion. templ-components v1.21 has no
// SegmentBar yet (it exists unreleased upstream), so this is the minimal
// native flex bar with exact counts in the legend — swap in SegmentBar when
// the next version publishes.
templ aiHumanCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "AI vs human"}) {
		if stats.Total == 0 {
			@display.SimpleEmptyState("No calls indexed yet.")
		} else {
			<div class="flex h-4 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
				<div class="h-full bg-blue-600 dark:bg-blue-400" style={ proportion(stats.AICalls, stats.Total) }></div>
				<div class="h-full bg-emerald-600 dark:bg-emerald-400" style={ proportion(stats.HumanCalls, stats.Total) }></div>
			</div>
			<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
				AI { strconv.Itoa(stats.AICalls) } · Human { strconv.Itoa(stats.HumanCalls) } · { aiShare(stats) } AI
			</p>
		}
	}
}

// trendCard is the 30-day sparkline over the same series as the bar chart.
templ trendCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "30-day trend"}) {
		@display.Sparkline(display.SparklineProps{
			Values: volumeValues(stats.ByDay),
			Filled: true,
			Width:  260,
			Height: 60,
		})
	}
}

// mosCard renders the mean MOS and per-day trend once any call reports a
// score; before the first MOS arrives it stays the honest placeholder so a
// quiet index never fakes a measurement.
templ mosCard(stats DashboardStats) {
	@display.Card(display.CardProps{Title: "Call quality (MOS)"}) {
		if stats.MOSKnown == 0 {
			@feedback.Alert(feedback.AlertProps{
				Type:    feedback.FeedbackInfo,
				Title:   "Not available yet",
				Message: "MOS scores land with the CDR Detail-Records poller (T15). This card will show the quality trend once that data flows.",
			})
		} else {
			<p class="text-2xl font-semibold">{ avgMOSLabel(stats) }</p>
			<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
				mean of { scoredCallsLabel(stats.MOSKnown) }
			</p>
			if hasWindowMOS(stats.ByDay) {
				<div class="mt-3">
					@display.BarChart(display.BarChartProps{
						Bars:         mosBars(stats.ByDay),
						Orient:       display.BarVertical,
						MinBarWidth:  "min-w-1",
						Gap:          "gap-px",
						ShowValues:   false,
						EmptyMessage: "No MOS data in the last " + strconv.Itoa(stats.WindowDays) + " days",
					})
				</div>
			} else {
				<p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
					No MOS data in the last { strconv.Itoa(stats.WindowDays) } days.
				</p>
			}
		}
	}
}

// mosBars maps per-day mean MOS onto chart bars. A day without scores keeps
// its slot as an empty bar whose tooltip says so: a missing measurement must
// never render as a 0.0 dip in quality.
func mosBars(days []DayVolume) []display.BarChartBar {
	bars := make([]display.BarChartBar, 0, len(days))
	for _, day := range days {
		bar := display.BarChartBar{Label: day.Day[5:], Value: day.AvgMOS()}
		if day.MOSKnown == 0 {
			bar.Tooltip = day.Day + ": no MOS data"
		} else {
			bar.Tooltip = day.Day + ": avg " + strconv.FormatFloat(day.AvgMOS(), 'f', 2, 64) +
				" (" + strconv.Itoa(day.MOSKnown) + " scored)"
		}

		bars = append(bars, bar)
	}

	return bars
}

func avgMOSLabel(stats DashboardStats) string {
	return strconv.FormatFloat(stats.AvgMOS(), 'f', 1, 64)
}

// hasWindowMOS reports whether any day inside the chart window carries a
// score; without it the chart shows nothing at all, so the card explains
// itself in text instead.
func hasWindowMOS(days []DayVolume) bool {
	for _, day := range days {
		if day.MOSKnown > 0 {
			return true
		}
	}

	return false
}

// scoredCallsLabel renders "N scored calls" with honest singular when the
// index holds exactly one measured call.
func scoredCallsLabel(known int) string {
	if known == 1 {
		return "1 scored call"
	}

	return strconv.Itoa(known) + " scored calls"
}

// volumeBars maps the day series onto chart bars (oldest → newest).
func volumeBars(days []DayVolume) []display.BarChartBar {
	bars := make([]display.BarChartBar, 0, len(days))
	for _, day := range days {
		bars = append(bars, display.BarChartBar{
			Label:   day.Day[5:], // MM-DD keeps the dense axis readable
			Value:   float64(day.Calls),
			Tooltip: day.Day + ": " + strconv.Itoa(day.Calls),
		})
	}

	return bars
}

// volumeValues is the same series as plain numbers for the sparkline.
func volumeValues(days []DayVolume) []float64 {
	values := make([]float64, 0, len(days))
	for _, day := range days {
		values = append(values, float64(day.Calls))
	}

	return values
}

func volumeTitle(windowDays int) string {
	return "Calls per day (last " + strconv.Itoa(windowDays) + " days)"
}

// aiShare renders the AI percentage, or an em dash when nothing is indexed
// (0 calls → "0.0%" would imply measurement, not absence).
func aiShare(stats DashboardStats) string {
	if stats.Total == 0 {
		return "—"
	}

	return percent(stats.AIRatio())
}

// percent renders a [0,1] ratio as "NN.N%" — one decimal, honest above 100.
func percent(ratio float64) string {
	return strconv.FormatFloat(ratio*100, 'f', 1, 64) + "%"
}

// proportion renders one segment's width as a CSS percentage string.
func proportion(part, total int) string {
	if total == 0 {
		return "width:0%"
	}

	return "width:" + strconv.FormatFloat(float64(part)/float64(total)*100, 'f', 2, 64) + "%"
}
