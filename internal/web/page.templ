package web

import "github.com/larsartmann/templ-components/layout"

// shell is the shared page frame: nav, theme toggle, htmx error handling.
templ shell(title string, currentPath string) {
	@layout.Base(pageProps(title)) {
		@nav(currentPath)
		<main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
			{ children... }
		</main>
	}
}
