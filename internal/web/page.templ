package web

import (
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/navigation"
)

// shell is the shared page frame: nav, container, footer, theme toggle.
// Base already emits the <main> landmark — the body is layout.Container
// (library gutter + width defaults) plus a restrained footer.
templ shell(title string, currentPath string) {
	@layout.Base(pageProps(title)) {
		@feedback.ToastContainer("")
		@nav(currentPath)
		@layout.Container(layout.ContainerProps{Class: "flex-1 py-8"}) {
			{ children... }
		}
		@footer()
		@htmx.GlobalErrorHandling(htmx.DefaultErrorHandlingConfig())
	}
}

// footer anchors the page and states the tool's read-only contract plus the
// running build (plan T16): the version comes from Go build info — present
// for git builds, "(devel)" for nix store builds, where the footer simply
// omits it rather than lying.
templ footer() {
	@navigation.Footer(navigation.FooterProps{
		BrandText: "pbx-lens",
		BottomBar: footerBottomBar(),
	})
}

templ footerBottomBar() {
	<div class="flex flex-wrap items-center justify-between gap-2 text-xs text-gray-500 dark:text-gray-400">
		<span>Read-only index — every source stays authoritative; this DB is disposable.</span>
		if v := buildVersion(); v != "" {
			<span class="font-mono">{ v }</span>
		}
	</div>
}
