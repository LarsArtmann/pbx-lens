package web

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/larsartmann/pbx-lens/internal/calls"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/navigation"
	"github.com/larsartmann/templ-components/utils/format"
)

// listRoute is the full list page: shell + optional staleness banner + the
// calls table. The banner lives in a polled region (R9): with htmx running
// it re-checks itself every minute and disappears on recovery; without JS
// the server-rendered fallback stands unchanged.
templ listRoute(nonce string, page CallListPage, filters ListCallsQuery, staleFor time.Duration, stale bool) {
	@shell(nonce, "Calls — pbx-lens", "/") {
		@staleLive(filters, staleFor, stale)
		@listPage(nonce, page, filters)
	}
}

// staleLive is the self-polling staleness-banner wrapper. The poll URL
// carries the page's own query (plan T9): the fragment re-runs the same
// ListCalls so its banner state always describes the view on screen —
// typed filters and walk cursors alike — instead of silently re-checking
// an unfiltered head page.
templ staleLive(filters ListCallsQuery, staleFor time.Duration, stale bool) {
	@htmx.PolledRegion(htmx.PolledRegionProps{
		URL:   "/frag/staleness" + filtersQueryString(filters),
		Every: "60s",
	}) {
		if stale {
			@staleBanner(staleFor)
		}
	}
}

// detailRoute is the per-call page: metadata, transcript, recording player.
// The page model joins the sibling source rows for the same call (a CDR and
// its agent transcript are two rows of one call), so whichever row the
// operator opened the page tells the whole story. query carries the search
// deep link (?q=, plan T21): it turns the transcript into a match-marked log
// with per-turn anchors.
templ detailRoute(nonce string, page DetailPage, query string) {
	@shell(nonce, callTitle(page.CallView), "/") {
		@display.PageHeader(display.PageHeaderProps{
			Title:             callTitle(page.CallView),
			SubtitleComponent: sourceBadge(page.Kind),
			Breadcrumb:        detailBreadcrumbs(page.CallView),
			Action:            nativeIDCopy(nonce, page.CallView),
		})
		@layout.Split(layout.SplitProps{
			Main:  detailMain(nonce, page, query),
			Aside: recordingCard(page),
		})
	}
}

// detailBreadcrumbs orients the detail page (plan T8): Calls → source kind →
// id. JSON-LD stays off — the kind segment has no honest list URL (the list
// has no kind filter), and schema.org breadcrumbs want a URL per crumb.
templ detailBreadcrumbs(view calls.CallView) {
	@navigation.Breadcrumbs(navigation.BreadcrumbsProps{
		Items: []navigation.BreadcrumbItem{
			{Text: "Calls", Href: "/"},
			{Text: string(view.Kind)},
			{Text: callTitle(view)},
		},
	})
}

// nativeIDCopy is the PageHeader action (plan T20): the native id is the
// value operators paste into source-system consoles, so it gets one-click
// copy beside the title. Button variant (no Href) is deliberate — a copy-as-
// link would carry a session-scoped route, not the id itself.
templ nativeIDCopy(nonce string, view calls.CallView) {
	@display.CopyButton(display.CopyButtonProps{
		Text:      string(view.NativeID),
		Label:     "Copy ID",
		AriaLabel: "Copy call ID " + string(view.NativeID),
		Nonce:     nonce,
	})
}

// copyableValue pairs a facts-row value with a copy affordance (plan T20).
// It rides DefinitionItem.DetailComponent: for an unobserved value the
// component stays nil and the plain dash Detail stands.
templ copyableValue(nonce string, value, label string) {
	<span class="inline-flex items-center gap-2">
		<span>{ value }</span>
		@display.CopyButton(display.CopyButtonProps{
			Text:      value,
			AriaLabel: "Copy " + label,
			Nonce:     nonce,
		})
	</span>
}

// sourceBadge names the originating system as a neutral pill under the title.
func sourceBadge(kind calls.SourceKind) templ.Component {
	return display.Badge(display.BadgeProps{Text: string(kind), Type: display.BadgeNeutral, Pill: true})
}

// detailMain is the Split's primary column: facts card, then transcript,
// then the source's own non-speech log. The empty state branches on whether
// the source wrote anything at all: "no transcript" and "the source recorded
// no spoken turn, and said so in its own log" are different facts, and the
// 2026-10-23 forensic call was misread precisely because the page rendered
// both as "the caller did not respond".
templ detailMain(nonce string, page DetailPage, query string) {
	@layout.Stack(layout.StackProps{Gap: layout.StackGapLG}) {
		@detailFacts(nonce, page)
		if len(page.Transcript) > 0 {
			@transcriptPane(page.Transcript, query)
		} else {
			@display.EmptyState(display.EmptyStateProps{
				Title:       noTranscriptTitle(page),
				Description: noTranscriptDescription(page),
				Icon:        icons.Microphone,
			})
		}
		if len(page.SourceEvents) > 0 {
			@sourceEventPane(page.SourceEvents)
		}
	}
}

templ detailFacts(nonce string, page DetailPage) {
	@display.Card(display.CardProps{Title: "Call facts", TitleTag: display.HeadingTagH2}) {
		@display.DefinitionList(display.DefinitionListProps{Items: detailItems(nonce, page)})
	}
}

// detailItems builds the term/detail pairs in display order. Conditional
// facts (cost, insight, joined sources) append only when the page actually
// carries them.
func detailItems(nonce string, page DetailPage) []display.DefinitionItem {
	view := page.CallView

	items := []display.DefinitionItem{
		{Term: "From", Detail: format.StringOrDash(view.FromNumber), DetailComponent: copyDetail(nonce, view.FromNumber, "from number")},
		{Term: "To", Detail: format.StringOrDash(view.ToNumber), DetailComponent: copyDetail(nonce, view.ToNumber, "to number")},
		{Term: "Started", Detail: view.StartedAt.Local().Format("Jan 2, 2006 15:04:05")},
		{Term: "Duration", Detail: format.ClockDuration(time.Duration(view.DurationSecs) * time.Second)},
		// Direction/Who ride the same badges the calls table uses — one
		// vocabulary across pages.
		{Term: "Direction", Detail: string(view.Direction), DetailComponent: directionBadge(string(view.Direction))},
		{Term: "Who", Detail: whoText(view.IsAI), DetailComponent: whoBadge(view.IsAI)},
		{Term: "Hangup cause", Detail: format.StringOrDash(view.HangupCause)},
	}
	if view.CostMicros != 0 {
		items = append(items, display.DefinitionItem{
			Term:   "Cost",
			Detail: costText(view.CostMicros, view.CostCurrency),
		})
	}
	if view.InsightSummary != "" {
		items = append(items, display.DefinitionItem{
			Term:   "AI insight",
			Detail: view.InsightSummary,
		})
	}
	// Diagnostics append only when they fire, so a clean call's facts card
	// keeps its historical shape (and its golden).
	items = append(items, diagnosticItems(view)...)
	// Provenance for the joined facts: the page fills the transcript or the
	// parties from the sibling source row that observed the same call, and
	// never hides that it did.
	if len(page.JoinedFrom) > 0 {
		items = append(items, display.DefinitionItem{
			Term:            "Also indexed as",
			Detail:          joinedSourceText(page.JoinedFrom),
			DetailComponent: joinedSourceBadges(page.JoinedFrom),
		})
	}
	if page.CounterpartHistory != nil {
		items = append(items, display.DefinitionItem{
			Term:            "History",
			Detail:          counterpartHistoryText(page.CounterpartHistory),
			DetailComponent: counterpartHistoryLink(page.CounterpartHistory),
		})
	}

	return items
}

// counterpartHistoryText names the population and the newest call — the
// plain-text twin of the drill-through link, and the honest fallback when
// the component does not render.
func counterpartHistoryText(history *CounterpartHistory) string {
	calls := strconv.Itoa(history.Calls) + " calls"
	if history.Calls == 1 {
		calls = "1 call"
	}

	return calls + " with " + history.Number + ", latest " + history.LastSeen.Local().Format("Jan 2, 2006 15:04")
}

templ counterpartHistoryLink(history *CounterpartHistory) {
	<a
		href={ "/?number=" + url.QueryEscape(history.Number) }
		class="font-medium text-tc-primary hover:underline dark:text-tc-info"
	>
		{ counterpartHistoryText(history) }
	</a>
}

// joinedSourceText is the plain-text twin of the badge list (DefinitionItem
// Detail stays the honest fallback when the component does not render).
func joinedSourceText(kinds []calls.SourceKind) string {
	names := make([]string, 0, len(kinds))
	for _, kind := range kinds {
		names = append(names, string(kind))
	}

	return strings.Join(names, ", ")
}

templ joinedSourceBadges(kinds []calls.SourceKind) {
	<span class="inline-flex flex-wrap items-center gap-2">
		for _, kind := range kinds {
			@sourceBadge(kind)
		}
	</span>
}

// copyDetail returns the copyable variant of a facts value; nil keeps the
// plain Detail fallback for empty values.
func copyDetail(nonce string, value, label string) templ.Component {
	if value == "" {
		return nil
	}

	return copyableValue(nonce, value, label)
}

// transcriptPane renders the role-split transcript as a terminal-style
// voice log: the caller's words and the assistant's replies read top-down
// with tone-colored role tags. No stagger — a transcript is reading
// content, not a replay animation. With a search query (T21) the lines
// hand-roll instead (thin piece, SegmentBar precedent): the library line
// has no id/class hook in v1.21.0, and the match view needs per-turn
// anchors plus a visible mark. Visual parity is pinned by the goldens.
templ transcriptPane(turns []calls.TranscriptTurn, query string) {
	@display.Card(display.CardProps{Title: "Transcript", ID: "transcript", TitleTag: display.HeadingTagH2}) {
		// AriaLabel: the library renders the block aria-hidden by default —
		// without the label a screen reader gets an empty transcript (plan
		// T18).
		if query == "" {
			@display.Scrollback(display.ScrollbackProps{
				AriaLabel: "Call transcript",
				Stagger:   false,
				Lines:     transcriptLines(turns),
			})
		} else {
			@transcriptMatchLog(turns, query)
		}
	}
}

// sourceEventPane renders the source's own non-speech entries verbatim:
// idle markers (Telnyx writes "[long silence]" when no user turn arrived),
// tool calls, blank rows. It is visually subordinate to the transcript on
// purpose — it explains silence, it is not speech — but it is never hidden,
// because the markers are the source admitting what it did not hear.
templ sourceEventPane(events []calls.SourceEvent) {
	@display.Card(display.CardProps{Title: "Source log", ID: "source-log", TitleTag: display.HeadingTagH2}) {
		<p class="mb-2 text-xs text-gray-500 dark:text-gray-400">
			Entries the source wrote that are not spoken turns. They are quoted as written, never interpreted.
		</p>
		<div class="tc-log text-start border-y border-gray-200 py-3 font-mono text-[0.8125rem] leading-relaxed text-gray-500 dark:border-gray-700 dark:text-gray-500" role="log" aria-label="Source log">
			for _, event := range events {
				<div class="tc-log-line tc-log-line-still italic">
					<span class="me-2 inline-block min-w-12 font-medium not-italic">{ event.Role }</span>
					if event.Text == "" {
						<span>(empty)</span>
					} else {
						<span>{ event.Text }</span>
					}
					if !event.At.IsZero() {
						<span class="ms-2 text-xs not-italic">{ event.At.Local().Format("15:04:05") }</span>
					}
				</div>
			}
		</div>
	}
}

// noTranscriptTitle separates "nothing was recorded" from "the source
// recorded markers but no speech" — the second is a finding, not a gap.
func noTranscriptTitle(page DetailPage) string {
	if len(page.SourceEvents) > 0 {
		return "No spoken turns recorded"
	}

	return "No transcript"
}

// noTranscriptDescription states what the SOURCE did, never a guess about
// the call. When markers exist they are the source's own record that no user
// turn arrived, so the copy points at the log instead of shrugging.
func noTranscriptDescription(page DetailPage) string {
	if len(page.SourceEvents) == 0 {
		return "No source recorded a transcript for this call yet " +
			"(human calls, or the agent transcript file is not ingested)."
	}

	return "The source wrote " + strconv.Itoa(len(page.SourceEvents)) +
		" non-speech entries for this call and no spoken turn; they are quoted below. " +
		"That is the source's own record, not a UI filter — usually a greeting collision, " +
		"a hangup mid-sentence, or audio that never reached the recognizer."
}

// transcriptTailThreshold is the "the source stopped writing long before the
// line dropped" bar. The 2026-10-23 forensic call ended 29.2 s after its last
// recorded turn start (45.06 s recording, last turn at 15.83 s) while the far
// end was still speaking at 44.3 s, so a 30 s bar would have missed the very
// case this signal exists for; 20 s catches it without flagging a call that
// ends on a normal goodbye.
const transcriptTailThreshold = 20 * time.Second

// diagnosticDetail renders a signal badge WITH its explanation. The library's
// DefinitionItem shows DetailComponent INSTEAD of Detail, so a badge-only entry
// would hide the sentence that says what fired and what it means.
templ diagnosticDetail(props display.BadgeProps, note string) {
	<div class="flex flex-wrap items-center gap-2">
		@display.Badge(props)
		<span class="text-xs text-gray-500 dark:text-gray-400">{ note }</span>
	</div>
}

// diagnosticItems are the call-fact additions that fire only when something
// about the recording, the transcript or the parties is worth a second look.
// Every signal is derived from facts already on the view: no extra source
// call, no inference.
func diagnosticItems(view calls.CallView) []display.DefinitionItem {
	var items []display.DefinitionItem

	userTurns := 0

	for _, turn := range view.Transcript {
		if turn.Role == calls.TurnRoleUser {
			userTurns++
		}
	}

	if len(view.Transcript) > 0 && userTurns == 0 {
		note := "0 — every recorded turn is the assistant's"
		items = append(items, display.DefinitionItem{
			Term:            "User turns",
			Detail:          note,
			DetailComponent: diagnosticDetail(display.BadgeProps{Text: "no user turn", Type: display.BadgeWarning, Pill: true}, note),
		})
	}

	if len(view.SourceEvents) > 0 {
		note := strconv.Itoa(len(view.SourceEvents)) + " non-speech entries the source wrote itself"
		items = append(items, display.DefinitionItem{
			Term:            "Source log",
			Detail:          note,
			DetailComponent: diagnosticDetail(display.BadgeProps{Text: "source markers", Type: display.BadgeNeutral, Pill: true}, note),
		})
	}

	if view.FromNumber != "" && view.FromNumber == view.ToNumber {
		const note = "both parties are the same number"
		items = append(items, display.DefinitionItem{
			Term:            "Legs",
			Detail:          note,
			DetailComponent: diagnosticDetail(display.BadgeProps{Text: "self-dial", Type: display.BadgeWarning, Pill: true}, note),
		})
	}

	if tail, ok := transcriptTail(view); ok && tail >= transcriptTailThreshold {
		note := format.ClockDuration(tail) + " elapsed after the last recorded turn started"
		items = append(items, display.DefinitionItem{
			Term:            "Recording tail",
			Detail:          note,
			DetailComponent: diagnosticDetail(display.BadgeProps{Text: format.ClockDuration(tail) + " unlogged", Type: display.BadgeWarning, Pill: true}, note),
		})
	}

	return items
}

// transcriptTail reports how long the call ran past the last turn's start.
// Turn times are truncated to whole seconds and sources without per-turn
// stamps leave At zero, so a transcript with no usable stamp yields false and
// the signal stays off rather than guessing.
func transcriptTail(view calls.CallView) (time.Duration, bool) {
	var last time.Time

	for _, turn := range view.Transcript {
		if turn.At.After(last) {
			last = turn.At
		}
	}

	if last.IsZero() || view.DurationSecs <= 0 || view.StartedAt.IsZero() {
		return 0, false
	}

	tail := time.Duration(view.DurationSecs)*time.Second - last.Sub(view.StartedAt)
	if tail < 0 {
		return 0, false
	}

	return tail, true
}

// transcriptMatchLog hand-rolls the scrollback line loop for the ?q= path:
// same block and line classes as the library component, plus a turn-N id
// on every line (the redirect's fragment target) and an amber mark on
// matches. Match rule is all-terms case-insensitive substring — FTS
// tokenizes differently, so a hit whose terms only match the FTS index
// still renders (no highlight, redirect skipped).
templ transcriptMatchLog(turns []calls.TranscriptTurn, query string) {
	<div class="tc-log text-start border-y border-gray-200 py-3 font-mono text-[0.8125rem] leading-relaxed text-gray-600 dark:border-gray-700 dark:text-gray-400" role="log" aria-label="Call transcript">
		for _, line := range transcriptMatchViews(turns, query) {
			if line.Matched {
				<div id={ "turn-" + strconv.Itoa(line.Index) } class="tc-log-line tc-log-line-still rounded bg-amber-100 dark:bg-amber-900/40">
					<span class={ turnTagClass(line.Role) }>{ string(line.Role) }</span>
					{ line.Text }
				</div>
			} else {
				<div class="tc-log-line tc-log-line-still">
					<span class={ turnTagClass(line.Role) }>{ string(line.Role) }</span>
					{ line.Text }
				</div>
			}
		}
	</div>
}

// transcriptLines maps conversation turns onto scrollback lines. The role
// tag keeps its source vocabulary (user/assistant) — it names who spoke,
// not what the UI thinks of them.
func transcriptLines(turns []calls.TranscriptTurn) []display.ScrollbackLine {
	lines := make([]display.ScrollbackLine, 0, len(turns))
	for _, turn := range turns {
		tone := display.ScrollbackToneSuccess
		if turn.Role == calls.TurnRoleUser {
			tone = display.ScrollbackToneInfo
		}

		lines = append(lines, display.ScrollbackLine{
			Tag:  string(turn.Role),
			Text: turn.Text,
			Tone: tone,
		})
	}

	return lines
}

// transcriptMatchView is one turn in the ?q= rendering: the turn itself,
// its transcript position (the turn-N anchor), and whether it matches.
type transcriptMatchView struct {
	calls.TranscriptTurn
	Index   int
	Matched bool
}

// transcriptMatchViews pairs every turn with its match state once, so the
// templ loop stays declarative.
func transcriptMatchViews(turns []calls.TranscriptTurn, query string) []transcriptMatchView {
	views := make([]transcriptMatchView, 0, len(turns))
	for index, turn := range turns {
		views = append(views, transcriptMatchView{
			TranscriptTurn: turn,
			Index:          index,
			Matched:        turnMatches(turn, query),
		})
	}

	return views
}

// firstMatchedTurn reports the transcript position of the first matching
// turn — the redirect's fragment target (plan T21).
func firstMatchedTurn(turns []calls.TranscriptTurn, query string) (int, bool) {
	for index, turn := range turns {
		if turnMatches(turn, query) {
			return index, true
		}
	}

	return 0, false
}

// turnMatches applies the highlight rule: every whitespace-separated term
// must appear in the turn text, case-insensitively. Substring, not token —
// partial numbers and mid-word snippets behave like the search page's
// digits-only hint promises.
func turnMatches(turn calls.TranscriptTurn, query string) bool {
	terms := strings.Fields(query)
	if len(terms) == 0 {
		return false
	}

	text := strings.ToLower(turn.Text)
	for _, term := range terms {
		if !strings.Contains(text, strings.ToLower(term)) {
			return false
		}
	}

	return true
}

// turnTagClass mirrors the library's scrollback tone colors for the
// hand-rolled match log. The colors themselves live in app.css
// (.tc-tag-user/.tc-tag-assistant) — raw palette classes are banned in
// .templ sources (palette gate), so the tags ride the same bridged vars
// the library tones resolve through and the one-block re-skin holds.
func turnTagClass(role calls.TurnRole) string {
	if role == calls.TurnRoleUser {
		return "me-2 inline-block min-w-12 font-medium tc-tag-user"
	}

	return "me-2 inline-block min-w-12 font-medium tc-tag-assistant"
}

// recordingCard offers playback. The audio src is the proxy route — the
// Telnyx signed URL never reaches the browser; local recordings stream from
// the same route when the file exists on disk. The two sources are
// independent: a FreeSWITCH call indexes no RecordingRef at all (its audio is
// a local WAV named after the call uuid), so the card keys on what the server
// actually resolved, never on one field's emptiness.
templ recordingCard(page DetailPage) {
	@display.Card(display.CardProps{Title: "Recording", TitleTag: display.HeadingTagH2}) {
		if page.RecordingRef != "" || page.LocalRecording != "" {
			<audio controls preload="none" class="w-full" src={ recordingHref(page.CallView) }></audio>
			<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Streams server-side; the source URL never reaches the browser.</p>
			if page.LocalRecording != "" {
				<p class="mt-1 font-mono text-xs text-gray-500 dark:text-gray-400">{ page.LocalRecording }</p>
			}
		} else if localRecordingKind(page.Kind) {
			@display.SimpleEmptyState("No recording file found on disk for this call.")
		} else {
			@display.SimpleEmptyState("No recording reference indexed for this call.")
		}
	}
}

// localRecordingKind reports whether this source addresses a local WAV by
// call uuid (the same resolver the recording route uses).
func localRecordingKind(kind calls.SourceKind) bool {
	return kind == calls.SourceFreeSwitchCDR || kind == calls.SourceAgentTranscript
}

templ notFoundPage(nonce string, message string) {
	@shell(nonce, "Not found — pbx-lens", "/") {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "Not found",
			Description: message,
			Icon:        icons.Question,
			ActionText:  "Back to calls",
			ActionHref:  "/",
		})
	}
}

func callTitle(view calls.CallView) string {
	return "Call " + string(view.NativeID)
}

func whoText(isAI bool) string {
	if isAI {
		return "AI"
	}

	return "Human"
}

func costText(micros int64, currency string) string {
	units := strconv.FormatFloat(float64(micros)/calls.MicrosPerUnit, 'f', -1, 64)
	return units + " " + format.StringOrDash(currency)
}

func recordingHref(view calls.CallView) string {
	return "/calls/" + string(view.Kind) + "/" + string(view.NativeID) + "/recording"
}
