package web

import (
	"strconv"
	"time"

	"github.com/larsartmann/pbx-lens/internal/calls"
	"github.com/larsartmann/templ-components/display"
)

// listRoute is the full list page: shell + optional staleness banner + the
// calls table.
templ listRoute(page CallListPage, filters ListCallsQuery, staleFor time.Duration, stale bool) {
	@shell("Calls — pbx-lens", "/") {
		if stale {
			@staleBanner(staleFor)
		}
		@listPage(page, filters)
	}
}

// detailRoute is the per-call page: metadata, transcript, recording player.
// Everything is read from the one CallView snapshot.
templ detailRoute(view calls.CallView) {
	@shell(callTitle(view), "/") {
		@display.PageHeader(display.PageHeaderProps{
			Title:    callTitle(view),
			Subtitle: "source: " + string(view.Kind),
		})
		<div class="grid items-start gap-6 lg:grid-cols-3">
			<div class="space-y-6 lg:col-span-2">
				@detailFacts(view)
				if len(view.Transcript) > 0 {
					@transcriptPane(view.Transcript)
				} else {
					@display.EmptyState(display.EmptyStateProps{
						Title:       "No transcript",
						Description: "This source recorded no transcript (human calls, or the transcript file is not ingested yet).",
					})
				}
			</div>
			<aside>
				@recordingCard(view)
			</aside>
		</div>
	}
}

templ detailFacts(view calls.CallView) {
	@display.Card(display.CardProps{Title: "Call facts"}) {
		@display.DefinitionList(display.DefinitionListProps{Items: detailItems(view)})
	}
}

// detailItems builds the term/detail pairs in display order. Conditional
// facts (cost, insight) append only when the source actually carries them.
func detailItems(view calls.CallView) []display.DefinitionItem {
	items := []display.DefinitionItem{
		{Term: "From", Detail: stringOrDash(view.FromNumber)},
		{Term: "To", Detail: stringOrDash(view.ToNumber)},
		{Term: "Started", Detail: view.StartedAt.Local().Format("Jan 2, 2006 15:04:05")},
		{Term: "Duration", Detail: clockDuration(time.Duration(view.DurationSecs) * time.Second)},
		{Term: "Direction", Detail: string(view.Direction)},
		{Term: "Who", Detail: whoText(view.IsAI)},
		{Term: "Hangup cause", Detail: stringOrDash(view.HangupCause)},
	}
	if view.CostMicros != 0 {
		items = append(items, display.DefinitionItem{
			Term:   "Cost",
			Detail: costText(view.CostMicros, view.CostCurrency),
		})
	}
	if view.InsightSummary != "" {
		items = append(items, display.DefinitionItem{
			Term:   "AI insight",
			Detail: view.InsightSummary,
		})
	}

	return items
}

// transcriptPane renders the role-split transcript in call order.
templ transcriptPane(turns []calls.TranscriptTurn) {
	@display.Card(display.CardProps{Title: "Transcript"}) {
		<div class="space-y-3">
			for _, turn := range turns {
				<div
					class={
						templ.KV("rounded-lg px-4 py-2 text-sm", turn.Role == "user"),
						"bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-gray-100",
					}
				>
					<span class="mr-2 font-semibold uppercase tracking-wide text-xs text-blue-600 dark:text-blue-400">{ turn.Role }</span>
					{ turn.Text }
				</div>
			}
		</div>
	}
}

// recordingCard offers playback. The audio src is the proxy route — the
// Telnyx signed URL never reaches the browser; local recordings stream from
// the same route when the file exists on disk.
templ recordingCard(view calls.CallView) {
	@display.Card(display.CardProps{Title: "Recording"}) {
		if view.RecordingRef == "" {
			<p class="text-sm text-gray-600 dark:text-gray-400">No recording reference indexed for this call.</p>
		} else {
			<audio controls preload="none" class="w-full" src={ recordingHref(view) }></audio>
			<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Streams server-side; the source URL never reaches the browser.</p>
		}
	}
}

templ notFoundPage(message string) {
	@shell("Not found — pbx-lens", "/") {
		@display.EmptyState(display.EmptyStateProps{
			Title:       "Not found",
			Description: message,
		})
		<div class="mt-4">
			@display.Button(display.ButtonProps{Text: "Back to calls", Href: "/"})
		</div>
	}
}

func callTitle(view calls.CallView) string {
	return "Call " + string(view.NativeID)
}

func whoText(isAI bool) string {
	if isAI {
		return "AI"
	}

	return "Human"
}

func costText(micros int64, currency string) string {
	units := strconv.FormatFloat(float64(micros)/calls.MicrosPerUnit, 'f', -1, 64)
	return units + " " + stringOrDash(currency)
}

func recordingHref(view calls.CallView) string {
	return "/calls/" + string(view.Kind) + "/" + string(view.NativeID) + "/recording"
}
